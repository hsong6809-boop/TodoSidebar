<Window x:Class="TodoSidebar.AchievementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="成就图鉴"
        Width="520"
        Height="640"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource GlassBrush}"
        WindowStyle="None"
        AllowsTransparency="True">
    <Border Background="{DynamicResource GlassBrush}"
            CornerRadius="14"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Border Background="{DynamicResource GlassLightBrush}"
                    Padding="20,14"
                    CornerRadius="14,14,0,0"
                    BorderThickness="0,0,0,1"
                    BorderBrush="{DynamicResource BorderBrush}"
                    Cursor="SizeAll"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🏅 成就图鉴"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}"/>
                        <TextBlock x:Name="SummaryText"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   VerticalAlignment="Center"
                                   Margin="12,0,0,0"/>
                    </StackPanel>
                    <Button Content="✕"
                            Width="28"
                            Height="28"
                            FontSize="14"
                            Background="Transparent"
                            Foreground="{DynamicResource TextSecondaryBrush}"
                            BorderThickness="0"
                            Cursor="Hand"
                            HorizontalAlignment="Right"
                            Click="CloseButton_Click"/>
                </Grid>
            </Border>

            <!-- 徽章列表 -->
            <ScrollViewer Grid.Row="1" Padding="16,12" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="BadgeList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,8"
                                    Padding="12,10"
                                    CornerRadius="8"
                                    Background="{DynamicResource CardBrush}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="BadgeIcon"
                                               FontSize="26"
                                               VerticalAlignment="Center"
                                               Margin="0,0,12,0"
                                               Text="{Binding Icon, Mode=OneWay}"/>
                                    <StackPanel Grid.Column="1">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock x:Name="BadgeName"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextBrush}"
                                                       Text="{Binding Name, Mode=OneWay}"/>
                                            <TextBlock x:Name="BadgeStatus"
                                                       FontSize="10"
                                                       Margin="8,0,0,0"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock x:Name="BadgeDesc"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   Margin="0,3,0,0"
                                                   Text="{Binding Description, Mode=OneWay}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsUnlocked}" Value="False">
                                    <Setter TargetName="BadgeIcon" Property="Opacity" Value="0.25"/>
                                    <Setter TargetName="BadgeName" Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                    <Setter TargetName="BadgeStatus" Property="Text" Value="未解锁"/>
                                    <Setter TargetName="BadgeStatus" Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsUnlocked}" Value="True">
                                    <Setter TargetName="BadgeStatus" Property="Text" Value="✅ 已解锁"/>
                                    <Setter TargetName="BadgeStatus" Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- 底部 -->
            <Border Grid.Row="2"
                    Padding="16,10"
                    BorderThickness="0,1,0,0"
                    BorderBrush="{DynamicResource BorderBrush}"
                    Background="{DynamicResource GlassLightBrush}"
                    CornerRadius="0,0,14,14">
                <TextBlock x:Name="FooterText"
                           FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           HorizontalAlignment="Center"/>
            </Border>
        </Grid>
    </Border>
</Window>
