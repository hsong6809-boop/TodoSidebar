<Application x:Class="TodoSidebar.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- 主题不变量令牌（字体/图标字体/间距） -->
                <ResourceDictionary Source="Themes/Tokens.Shared.xaml"/>
                <!-- 颜色令牌：ThemeManager 运行时整本替换 Light/Dark -->
                <ResourceDictionary Source="Themes/Tokens.Light.xaml"/>
                <!-- 控件样式库（含隐式样式：TextBox/CheckBox/RadioButton/ProgressBar/ToolTip/ScrollBar） -->
                <ResourceDictionary Source="Themes/Styles.Controls.xaml"/>
                <!-- 数据模板库 + 转换器 -->
                <ResourceDictionary Source="Themes/Styles.Templates.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- 全局字体兜底：未显式设置字体的原生控件继承应用字体 -->
            <Style TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{DynamicResource PrimaryFont}"/>
            </Style>
            <Style TargetType="Button">
                <Setter Property="FontFamily" Value="{DynamicResource PrimaryFont}"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
