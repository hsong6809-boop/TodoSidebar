<Window x:Class="TodoSidebar.FullWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:TodoSidebar.ViewModels"
        xmlns:controls="clr-namespace:TodoSidebar.Controls"
        xmlns:scm="clr-namespace:System.ComponentModel;assembly=WindowsBase"
        Title="每日任务"
        Width="640"
        Height="840"
        MinWidth="560"
        MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStyle="None"
        PreviewKeyDown="FullWindow_PreviewKeyDown">

    <Window.Resources>
        <!-- V2-W5：截止任务按紧急度分组（逾期 → 今天 → 未来7天 → 更远） -->
        <CollectionViewSource x:Key="GroupedDeadlines" Source="{Binding DeadlineTasks}">
            <CollectionViewSource.SortDescriptions>
                <scm:SortDescription PropertyName="DeadlineGroupOrder"/>
                <scm:SortDescription PropertyName="Deadline"/>
            </CollectionViewSource.SortDescriptions>
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="DeadlineGroupName"/>
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>
    </Window.Resources>

    <Border Background="{DynamicResource GlassBrush}"
            CornerRadius="14"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ===== 顶栏（可拖动）===== -->
            <Border Grid.Row="0"
                    Background="{DynamicResource GlassLightBrush}"
                    Padding="16,10"
                    CornerRadius="14,14,0,0"
                    BorderThickness="0,0,0,1"
                    BorderBrush="{DynamicResource BorderBrush}"
                    Cursor="SizeAll"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid>
                    <StackPanel Orientation="Horizontal">
                        <Border Background="{DynamicResource AccentBrush}"
                                CornerRadius="9" Width="30" Height="30" Margin="0,0,10,0">
                            <controls:AppIcon Glyph="{x:Static controls:Icons.CheckMark}"
                                              Foreground="White" FontSize="13"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="每日任务"
                                       FontSize="{DynamicResource FontSizeTitle}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextBrush}"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontSize="{DynamicResource FontSizeCaption}"
                                           Foreground="{DynamicResource TextSecondaryBrush}">
                                    <Run Text="共 "/>
                                    <Run Text="{Binding CurrentTasksCount, Mode=OneWay}" FontWeight="SemiBold"/>
                                    <Run Text=" 项待办"/>
                                </TextBlock>
                                <TextBlock Text="{Binding ComboDisplay}"
                                           FontSize="10" FontWeight="SemiBold"
                                           Foreground="{DynamicResource ComboBrush}"
                                           VerticalAlignment="Center" Margin="8,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button x:Name="ThemeToggleButton" Style="{StaticResource HeaderIconButton}"
                                Click="ThemeToggle_Click" ToolTip="切换明暗主题">
                            <controls:AppIcon x:Name="ThemeToggleIcon" Glyph="{x:Static controls:Icons.Moon}" FontSize="12"/>
                        </Button>
                        <controls:AvatarView x:Name="TopBarAvatar"
                                             Width="28" Height="28"
                                             Cursor="Hand" Margin="10,0,0,0"
                                             MouseLeftButtonDown="Avatar_Click"
                                             ToolTip="账号中心"/>
                        <Button Style="{StaticResource HeaderIconButton}" Click="BrowseBadges_Click" ToolTip="成就图鉴">
                            <controls:AppIcon Glyph="{x:Static controls:Icons.FavoriteStar}" FontSize="13"/>
                        </Button>
                        <Button Style="{StaticResource HeaderIconButton}" Click="SettingsButton_Click" ToolTip="设置" Margin="2,0,0,0">
                            <controls:AppIcon Glyph="{x:Static controls:Icons.Settings}" FontSize="13"/>
                        </Button>
                        <Button Style="{StaticResource HeaderIconButton}" Click="LogoutButton_Click" ToolTip="退出登录" Margin="2,0,0,0">
                            <controls:AppIcon Glyph="{x:Static controls:Icons.SignOut}" FontSize="12"/>
                        </Button>
                        <Button Style="{StaticResource HeaderIconButton}" Click="CollapseToSidebar_Click" ToolTip="收起为侧边栏" Margin="2,0,0,0">
                            <controls:AppIcon Glyph="{x:Static controls:Icons.ChevronLeft}" FontSize="11"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ===== 内容区：左导航栏 + 页面 ===== -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="72"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Navigation Rail -->
                <Border Grid.Column="0"
                        Background="{DynamicResource GlassLightBrush}"
                        BorderThickness="0,0,1,0"
                        BorderBrush="{DynamicResource BorderBrush}">
                    <DockPanel>
                        <!-- 底部：同步状态 + 设置 -->
                        <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,12">
                            <Ellipse Width="7" Height="7" Fill="{DynamicResource SuccessBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="已同步" FontSize="8" Foreground="{DynamicResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            <RadioButton GroupName="NavRail" Margin="0,10,0,0"
                                         Style="{StaticResource RailItemStyle}" ToolTip="设置"
                                         Checked="NavExtra_Checked">
                                <controls:AppIcon Glyph="{x:Static controls:Icons.Settings}" FontSize="17"/>
                            </RadioButton>
                        </StackPanel>
                        <!-- 导航项（紧凑排布于上部约 2/3 区域，间距均匀） -->
                        <Grid Margin="0,10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <RadioButton x:Name="NavDashboard" Grid.Row="0" GroupName="NavRail" IsChecked="True" Tag="Dashboard"
                                         Style="{StaticResource RailItemStyle}" ToolTip="今日"
                                         Checked="Nav_Checked" VerticalAlignment="Center">
                                <StackPanel>
                                    <controls:AppIcon Glyph="{x:Static controls:Icons.Calendar}" FontSize="20"/>
                                    <TextBlock Text="今日" FontSize="9.5" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="NavDeadline" Grid.Row="1" GroupName="NavRail" Tag="Deadline"
                                         Style="{StaticResource RailItemStyle}" ToolTip="截止"
                                         Margin="0,16,0,0" Checked="Nav_Checked" VerticalAlignment="Center">
                                <StackPanel>
                                    <controls:AppIcon Glyph="{x:Static controls:Icons.Clock}" FontSize="20"/>
                                    <TextBlock Text="截止" FontSize="10" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="NavHistory" Grid.Row="2" GroupName="NavRail" Tag="History"
                                         Style="{StaticResource RailItemStyle}" ToolTip="历史"
                                         Margin="0,16,0,0" Checked="Nav_Checked" VerticalAlignment="Center">
                                <StackPanel>
                                    <controls:AppIcon Glyph="{x:Static controls:Icons.CheckList}" FontSize="20"/>
                                    <TextBlock Text="历史" FontSize="10" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="NavStats" Grid.Row="3" GroupName="NavRail" Tag="Stats"
                                         Style="{StaticResource RailItemStyle}" ToolTip="统计"
                                         Margin="0,16,0,0" Checked="Nav_Checked" VerticalAlignment="Center">
                                <StackPanel>
                                    <controls:AppIcon Glyph="{x:Static controls:Icons.Chart}" FontSize="20"/>
                                    <TextBlock Text="统计" FontSize="10" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="NavFocus" Grid.Row="4" GroupName="NavRail" Tag="Focus"
                                         Style="{StaticResource RailItemStyle}" ToolTip="专注"
                                         Margin="0,16,0,0" Checked="Nav_Checked" VerticalAlignment="Center">
                                <StackPanel>
                                    <controls:AppIcon Glyph="{x:Static controls:Icons.PlayCircle}" FontSize="20"/>
                                    <TextBlock Text="专注" FontSize="10" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="NavAchievements" Grid.Row="5" GroupName="NavRail" Tag="Achievements"
                                         Style="{StaticResource RailItemStyle}" ToolTip="成就"
                                         Margin="0,16,0,0" Checked="Nav_Checked" VerticalAlignment="Center">
                                <StackPanel>
                                    <controls:AppIcon Glyph="{x:Static controls:Icons.Star}" FontSize="20"/>
                                    <TextBlock Text="成就" FontSize="10" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="NavTrash" Grid.Row="6" GroupName="NavRail" Tag="Trash"
                                         Style="{StaticResource RailItemStyle}" ToolTip="回收站"
                                         Margin="0,16,0,0" Checked="Nav_Checked" VerticalAlignment="Center">
                                <StackPanel>
                                    <controls:AppIcon Glyph="{x:Static controls:Icons.Delete}" FontSize="20"/>
                                    <TextBlock Text="回收站" FontSize="10" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                </StackPanel>
                            </RadioButton>
                        </Grid>
                    </DockPanel>
                </Border>

                <!-- 页面容器 -->
                <Grid Grid.Column="1" Margin="16,12">
                    <!-- ===== 今日仪表盘 ===== -->
                    <Grid x:Name="DashboardPanel">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- 页头（V2.1 对齐示意图）-->
                        <StackPanel Grid.Row="0" Margin="0,0,0,12">
                            <TextBlock Text="今天" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextBrush}"/>
                            <TextBlock x:Name="DashboardSubtitleText" Text=""
                                       FontSize="{DynamicResource FontSizeCaption}"
                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                        </StackPanel>

                        <!-- Composer（今日页内，V2.1b 迁移自底栏）-->
                        <Grid Grid.Row="1" Margin="0,0,0,10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TaskInput"
                                         Text="{Binding NewTaskTitle, UpdateSourceTrigger=PropertyChanged}"
                                         controls:Placeholder.Text="添加新任务，回车确认…"
                                         Style="{StaticResource GlassTextBox}"
                                         KeyDown="TaskInput_KeyDown"/>
                                <Button Grid.Column="1" Click="AddTaskButton_Click" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <controls:AppIcon Glyph="{x:Static controls:Icons.Add}" FontSize="11" Foreground="White" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                        <TextBlock Text="添加" Foreground="White" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <!-- V5.1：自然语言解析预览条（无可识别内容时隐藏）-->
                            <Border Grid.Row="1" Margin="0,6,0,0" Padding="8,3" CornerRadius="8"
                                    Background="{DynamicResource SurfaceHoverBrush}"
                                    Visibility="{Binding ComposerPreview, Converter={StaticResource EmptyToVis}}">
                                <TextBlock Text="{Binding ComposerPreview}" FontSize="11"
                                           Foreground="{DynamicResource AccentBrush}"
                                           TextTrimming="CharacterEllipsis"/>
                            </Border>
                        </Grid>

                        <!-- 类型分段 + 优先级 + 截止日期 -->
                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,12">
                            <Border Background="{DynamicResource SurfaceHoverBrush}" CornerRadius="999" Padding="3">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="TabDaily" Content="每日" GroupName="ComposerType" IsChecked="True"
                                                 Style="{StaticResource SegmentToggleStyle}" Checked="SegmentType_Checked"/>
                                    <RadioButton x:Name="TabDeadline" Content="截止" GroupName="ComposerType"
                                                 Style="{StaticResource SegmentToggleStyle}" Checked="SegmentType_Checked"/>
                                </StackPanel>
                            </Border>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                                <RadioButton x:Name="PriorityHighRadio" Content="高" Tag="High" Foreground="{DynamicResource PriorityHighBrush}" Margin="0,0,10,0" Checked="Priority_Checked"/>
                                <RadioButton x:Name="PriorityMediumRadio" Content="中" Tag="Medium" Foreground="{DynamicResource PriorityMediumBrush}" IsChecked="True" Margin="0,0,10,0" Checked="Priority_Checked"/>
                                <RadioButton x:Name="PriorityLowRadio" Content="低" Tag="Low" Foreground="{DynamicResource PriorityLowBrush}" Checked="Priority_Checked"/>
                            </StackPanel>

                            <DatePicker x:Name="DeadlinePicker"
                                        SelectedDate="{Binding NewTaskDeadline}"
                                        Margin="14,0,0,0" Width="140"
                                        Visibility="{Binding IsChecked, ElementName=TabDeadline, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>

                        <!-- KPI 行（保持 3 卡；今日输入为下方通栏细条，不挤占网格） -->
                        <UniformGrid Grid.Row="3" Columns="3" Margin="0,0,0,12">
                            <!-- 进度环卡 -->
                            <Border Background="{DynamicResource CardBrush}" CornerRadius="14" Padding="14,12"
                                    Margin="0,0,10,0">
                                <StackPanel Orientation="Horizontal">
                                    <Grid Width="62" Height="62" VerticalAlignment="Center">
                                        <controls:CircularProgress Size="62" StrokeThickness="7"
                                                                   Progress="{Binding TodayProgressRate}"
                                                                   BackgroundBrush="{DynamicResource SurfacePressedBrush}">
                                            <controls:CircularProgress.Style>
                                                <Style TargetType="controls:CircularProgress">
                                                    <Setter Property="ProgressBrush" Value="{DynamicResource AccentGradientBrush}"/>
                                                    <Style.Triggers>
                                                        <!-- R64 彩蛋：超额完成转金色 -->
                                                        <DataTrigger Binding="{Binding IsOverachieving}" Value="True">
                                                            <Setter Property="ProgressBrush" Value="{DynamicResource WarningBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </controls:CircularProgress.Style>
                                        </controls:CircularProgress>
                                        <TextBlock Text="{Binding TodayProgressRate, Converter={StaticResource FractionToPercent}}"
                                                   FontSize="11.5" FontWeight="Bold"
                                                   Foreground="{DynamicResource AccentBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                    <StackPanel VerticalAlignment="Center" Margin="14,0,0,0">
                                        <TextBlock Text="今日完成" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <!-- R62：与侧边栏同源（MainViewModel），消除双公式漂移 -->
                                        <TextBlock Text="{Binding TodayDoneText}" FontSize="19" FontWeight="Bold" Foreground="{DynamicResource TextBrush}"/>
                                        <TextBlock Text="较昨日" FontSize="10" Foreground="{DynamicResource TextTertiaryBrush}"/>
                                        <TextBlock x:Name="TodayDeltaText" Text="—" FontSize="10" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <!-- 连击卡 -->
                            <Border Background="{DynamicResource CardBrush}" CornerRadius="14" Padding="14,12"
                                    Margin="0,0,10,0">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🔥" FontSize="17" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding StatisticsViewModel.StreakDays, StringFormat=' {0} 天'}"
                                                   FontSize="18" FontWeight="Bold" Foreground="{DynamicResource ComboBrush}"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="连续全清 · 近 7 日" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                    <ItemsControl ItemsSource="{Binding StatisticsViewModel.DailyStats}" Margin="0,10,0,0">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Ellipse Width="9" Height="9" Margin="0,0,6,0">
                                                    <Ellipse.Style>
                                                        <Style TargetType="Ellipse">
                                                            <Setter Property="Fill" Value="{DynamicResource SurfacePressedBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding DotState}" Value="done">
                                                                    <Setter Property="Fill" Value="{DynamicResource WarningBrush}"/>
                                                                    <Setter Property="Opacity" Value="0.55"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding DotState}" Value="today">
                                                                    <Setter Property="Fill" Value="{DynamicResource WarningBrush}"/>
                                                                    <Setter Property="Opacity" Value="1"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Ellipse.Style>
                                                </Ellipse>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="{Binding ComboDisplay}" FontSize="10.5" FontWeight="SemiBold"
                                               Foreground="{DynamicResource ComboBrush}" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>
                            <!-- 等级卡 -->
                            <Border Background="{DynamicResource CardBrush}" CornerRadius="14" Padding="14,12"
                                   >
                                <StackPanel>
                                    <TextBlock Text="{Binding LevelDisplay}" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource TextBrush}"/>
                                    <ProgressBar Margin="0,8,0,4" Height="6" Minimum="0" Maximum="1"
                                                 Value="{Binding LevelProgress}"
                                                 Foreground="{DynamicResource AccentGradientBrush}"/>
                                    <TextBlock Text="{Binding LevelProgressText}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <!-- R61 今日输入通栏条：单行 20px 高，不参与 KPI 网格分栏 -->
                        <Border Background="{DynamicResource CardBrush}" CornerRadius="12"
                                Padding="12,7" Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⌨️" FontSize="13" VerticalAlignment="Center"/>
                                <TextBlock Text="今日输入"
                                           FontSize="{DynamicResource FontSizeCaption}"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           VerticalAlignment="Center" Margin="6,0,10,0"/>
                                <TextBlock Text="{Binding StatisticsViewModel.TodayTypingText}"
                                           FontSize="11.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextBrush}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- 双列：任务流 + 右栏 -->
                        <Grid Grid.Row="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="176"/>
                            </Grid.ColumnDefinitions>

                            <!-- 左：任务流 -->
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="1.25*"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Grid Margin="0,0,0,8">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="今日任务" FontSize="{DynamicResource FontSizeSubtitle}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                                        <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="999" Padding="8,2" Margin="8,0,0,0">
                                            <TextBlock Text="{Binding DailyTasksCount}" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="全部 ›" FontSize="{DynamicResource FontSizeCaption}"
                                               Foreground="{DynamicResource AccentBrush}" Cursor="Hand"
                                               HorizontalAlignment="Right" VerticalAlignment="Center"
                                               MouseLeftButtonDown="TodayAll_Click"/>
                                </Grid>

                                <Grid Grid.Row="1">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                                Visibility="{Binding DailyTasksCount, Converter={StaticResource ZeroToVisInv}}">
                                        <controls:AppIcon Glyph="{x:Static controls:Icons.CheckMark}"
                                                          FontSize="20"
                                                          Foreground="{DynamicResource AccentBrush}"
                                                          HorizontalAlignment="Center"/>
                                        <TextBlock Text="今天没有每日任务" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                    </StackPanel>
                                    <ListBox ItemsSource="{Binding DailyTasks}"
                                             Style="{StaticResource GlassListBox}"
                                             ItemTemplate="{StaticResource TaskCardTemplate}"
                                             x:Name="DailyTasksListBox"
                                             AllowDrop="True"
                                             Drop="TaskListBox_Drop"
                                             DragOver="TaskListBox_DragOver"
                                             PreviewMouseLeftButtonDown="TaskListBox_PreviewMouseLeftButtonDown"
                                             PreviewMouseMove="TaskListBox_PreviewMouseMove"
                                             MouseDoubleClick="TaskListBox_MouseDoubleClick"/>
                                </Grid>

                                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,8">
                                    <TextBlock Text="截止任务" FontSize="{DynamicResource FontSizeSubtitle}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                                    <Border Background="{DynamicResource DangerSoftBrush}" CornerRadius="999" Padding="8,2" Margin="8,0,0,0">
                                        <TextBlock Text="{Binding DeadlineTasksCount}" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource DangerBrush}"/>
                                    </Border>
                                </StackPanel>

                                <Grid Grid.Row="3">
                                    <!-- 空状态 -->
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                                Visibility="{Binding DeadlineTasksCount, Converter={StaticResource ZeroToVisInv}}">
                                        <controls:AppIcon Glyph="{x:Static controls:Icons.Calendar}"
                                                          FontSize="20"
                                                          Foreground="{DynamicResource TextTertiaryBrush}"
                                                          HorizontalAlignment="Center"/>
                                        <TextBlock Text="没有截止任务" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                    </StackPanel>

                                    <!-- 按紧急度分组 -->
                                    <ListBox ItemsSource="{Binding Source={StaticResource GroupedDeadlines}}"
                                             Style="{StaticResource GlassListBox}"
                                             ItemTemplate="{StaticResource DeadlineTaskCardTemplate}"
                                             x:Name="DeadlineTasksListBox"
                                             AllowDrop="True"
                                             Drop="TaskListBox_Drop"
                                             DragOver="TaskListBox_DragOver"
                                             PreviewMouseLeftButtonDown="TaskListBox_PreviewMouseLeftButtonDown"
                                             PreviewMouseMove="TaskListBox_PreviewMouseMove"
                                             MouseDoubleClick="TaskListBox_MouseDoubleClick">
                                        <ListBox.GroupStyle>
                                            <GroupStyle>
                                                <GroupStyle.ContainerStyle>
                                                    <Style TargetType="GroupItem">
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="GroupItem">
                                                                    <StackPanel>
                                                                        <Border Background="{DynamicResource SurfaceHoverBrush}"
                                                                                CornerRadius="8" Padding="8,3" Margin="0,2,0,4"
                                                                                HorizontalAlignment="Left">
                                                                            <StackPanel Orientation="Horizontal">
                                                                                <Ellipse x:Name="GroupDot" Width="6" Height="6"
                                                                                         Fill="{DynamicResource TextTertiaryBrush}"
                                                                                         VerticalAlignment="Center"/>
                                                                                <TextBlock Text="{Binding Name}" FontSize="10.5" FontWeight="SemiBold"
                                                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                                                           VerticalAlignment="Center" Margin="5,0,0,0"/>
                                                                                <TextBlock Text="{Binding ItemCount, StringFormat=' {0}'}" FontSize="9.5"
                                                                                           Foreground="{DynamicResource TextTertiaryBrush}"
                                                                                           VerticalAlignment="Center"/>
                                                                            </StackPanel>
                                                                        </Border>
                                                                        <ItemsPresenter/>
                                                                    </StackPanel>
                                                                    <ControlTemplate.Triggers>
                                                                        <DataTrigger Binding="{Binding Name}" Value="已逾期">
                                                                            <Setter TargetName="GroupDot" Property="Fill" Value="{DynamicResource DangerBrush}"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Name}" Value="今天">
                                                                            <Setter TargetName="GroupDot" Property="Fill" Value="{DynamicResource WarningBrush}"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Name}" Value="未来 7 天">
                                                                            <Setter TargetName="GroupDot" Property="Fill" Value="{DynamicResource AccentBrush}"/>
                                                                        </DataTrigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </GroupStyle.ContainerStyle>
                                            </GroupStyle>
                                        </ListBox.GroupStyle>
                                    </ListBox>
                                </Grid>
                            </Grid>

                            <!-- 右栏 -->
                            <ScrollViewer Grid.Column="1" Margin="14,0,0,0"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <!-- 今日挑战 -->
                                <TextBlock Text="今日挑战" FontSize="{DynamicResource FontSizeBody}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,8"/>
                                <Border Background="{DynamicResource CardBrush}" CornerRadius="14" Padding="12,10">
                                    <ItemsControl x:Name="ChallengeList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="0,4">
                                                    <Grid>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Icon}" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                            <TextBlock Text="{Binding Title}" FontSize="11" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding StatusText}" FontSize="10" FontWeight="Bold"
                                                                   Foreground="{DynamicResource SuccessBrush}"
                                                                   HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                    </Grid>
                                                    <Grid Margin="18,4,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Grid>
                                                            <Border Height="4" CornerRadius="2" Background="{DynamicResource SurfacePressedBrush}"/>
                                                            <Border HorizontalAlignment="Left" Height="4" CornerRadius="2"
                                                                    Width="{Binding BarWidth}"
                                                                    Background="{DynamicResource AccentGradientBrush}"/>
                                                        </Grid>
                                                        <TextBlock Grid.Column="1" Text="{Binding ProgressText}" FontSize="9"
                                                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                                                   VerticalAlignment="Center" Margin="6,0,0,0"/>
                                                    </Grid>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>

                                <!-- 快速专注 -->
                                <TextBlock Text="快速专注" FontSize="{DynamicResource FontSizeBody}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,14,0,8"/>
                                <Border Background="{DynamicResource CardBrush}" CornerRadius="14" Padding="14,12">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid Width="62" Height="62" VerticalAlignment="Center">
                                                <controls:CircularProgress x:Name="QuickFocusRing" Size="62" StrokeThickness="7"
                                                                           Progress="0"
                                                                           ProgressBrush="{DynamicResource AccentGradientBrush}"
                                                                           BackgroundBrush="{DynamicResource SurfacePressedBrush}"/>
                                                <TextBlock x:Name="QuickFocusTimeText" Text="25:00"
                                                           FontSize="11" FontWeight="Bold"
                                                           Foreground="{DynamicResource TextBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Grid>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                                                <TextBlock x:Name="QuickFocusStateText" Text="准备开始"
                                                           FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                                                <TextBlock x:Name="QuickFocusRoundText" Text="回合 0/4"
                                                           FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                        <Button x:Name="QuickFocusButton" Style="{StaticResource PrimaryButton}" Padding="0,6"
                                                Margin="0,10,0,0" Click="FocusStart_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <controls:AppIcon Glyph="{x:Static controls:Icons.Play}" FontSize="9" Foreground="White" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                                <TextBlock x:Name="QuickFocusLabel" Text="开始专注" FontSize="11.5" Foreground="White" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Border>

                                <!-- 同步状态 -->
                                <TextBlock Text="同步" FontSize="{DynamicResource FontSizeBody}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,14,0,8"/>
                                <Border Background="{DynamicResource CardBrush}" CornerRadius="14" Padding="14,12">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <!-- R(review 修复 v5.6)：状态点/文案由代码后台按真实同步状态刷新，不再硬编码"已同步" -->
                                            <Ellipse x:Name="SyncStatusDot" Width="7" Height="7" Fill="{DynamicResource SuccessBrush}" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="SyncStatusText" Text=" 已同步到云端" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                                        </StackPanel>
                                        <TextBlock x:Name="SyncStampText" Text="每 30 秒自动同步 · 支持多设备合并" FontSize="10"
                                                   Foreground="{DynamicResource TextTertiaryBrush}" Margin="15,4,0,0"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                            <Button Style="{StaticResource SecondaryButton}" Padding="9,5" Margin="0,0,6,0"
                                                    Command="{Binding SyncViewModel.UploadCommand}" ToolTip="上传到云端">
                                                <controls:AppIcon Glyph="{x:Static controls:Icons.Upload}" FontSize="11"/>
                                            </Button>
                                            <Button Style="{StaticResource SecondaryButton}" Padding="9,5"
                                                    Command="{Binding SyncViewModel.DownloadCommand}" ToolTip="从云端下载">
                                                <controls:AppIcon Glyph="{x:Static controls:Icons.Download}" FontSize="11"/>
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            </ScrollViewer>
                        </Grid>

                        <!-- 底部快捷键提示 -->
                        <TextBlock Grid.Row="5" Text="Ctrl+K 快速操作 · 双击卡片查看详情 · 悬停卡片显示删除"
                                   FontSize="9.5" Foreground="{DynamicResource TextTertiaryBrush}"
                                   HorizontalAlignment="Center" Margin="0,10,0,0"/>
                    </Grid>

                    <!-- ===== 截止页（V2.1 对齐示意图导航）===== -->
                    <Grid x:Name="DeadlinesPanel" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="截止任务" FontSize="{DynamicResource FontSizeSubtitle}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                            <Border Background="{DynamicResource WarningSoftBrush}" CornerRadius="999" Padding="8,2" Margin="8,0,0,0">
                                <TextBlock Text="{Binding DeadlineTasksCount}" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource ComboBrush}"/>
                            </Border>
                        </StackPanel>
                        <ListBox Grid.Row="1"
                                 ItemsSource="{Binding Source={StaticResource GroupedDeadlines}}"
                                 Style="{StaticResource GlassListBox}"
                                 ItemTemplate="{StaticResource DeadlineTaskCardTemplate}"
                                 AllowDrop="True"
                                 Drop="TaskListBox_Drop"
                                 DragOver="TaskListBox_DragOver"
                                 PreviewMouseLeftButtonDown="TaskListBox_PreviewMouseLeftButtonDown"
                                 PreviewMouseMove="TaskListBox_PreviewMouseMove"
                                 MouseDoubleClick="TaskListBox_MouseDoubleClick">
                            <ListBox.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.ContainerStyle>
                                        <Style TargetType="GroupItem">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="GroupItem">
                                                        <StackPanel>
                                                            <Border Background="{DynamicResource SurfaceHoverBrush}"
                                                                    CornerRadius="8" Padding="8,3" Margin="0,2,0,4"
                                                                    HorizontalAlignment="Left">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <Ellipse x:Name="GroupDot" Width="6" Height="6"
                                                                             Fill="{DynamicResource TextTertiaryBrush}"
                                                                             VerticalAlignment="Center"/>
                                                                    <TextBlock Text="{Binding Name}" FontSize="10.5" FontWeight="SemiBold"
                                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                                               VerticalAlignment="Center" Margin="5,0,0,0"/>
                                                                    <TextBlock Text="{Binding ItemCount, StringFormat=' {0}'}" FontSize="9.5"
                                                                               Foreground="{DynamicResource TextTertiaryBrush}"
                                                                               VerticalAlignment="Center"/>
                                                                </StackPanel>
                                                            </Border>
                                                            <ItemsPresenter/>
                                                        </StackPanel>
                                                        <ControlTemplate.Triggers>
                                                            <DataTrigger Binding="{Binding Name}" Value="已逾期">
                                                                <Setter TargetName="GroupDot" Property="Fill" Value="{DynamicResource DangerBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Name}" Value="今天">
                                                                <Setter TargetName="GroupDot" Property="Fill" Value="{DynamicResource WarningBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Name}" Value="未来 7 天">
                                                                <Setter TargetName="GroupDot" Property="Fill" Value="{DynamicResource AccentBrush}"/>
                                                            </DataTrigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </GroupStyle.ContainerStyle>
                                </GroupStyle>
                            </ListBox.GroupStyle>
                        </ListBox>
                    </Grid>

                    <!-- ===== 历史页 ===== -->
                    <DockPanel x:Name="HistoryPanel" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Top" Margin="0,0,0,10">
                            <TextBlock Text="历史记录" FontSize="{DynamicResource FontSizeSubtitle}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                            <Border Background="{DynamicResource SurfaceHoverBrush}" CornerRadius="999" Padding="8,2" Margin="8,0,0,0">
                                <TextBlock Text="{Binding HistoryTasksCount}" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </Border>
                        </StackPanel>
                        <ListBox ItemsSource="{Binding HistoryTasks}"
                                 Style="{StaticResource GlassListBox}"
                                 ItemTemplate="{StaticResource HistoryTaskCardTemplate}"/>
                    </DockPanel>

                    <!-- ===== 统计页（W6 升级为图表仪表盘）===== -->
                    <ScrollViewer x:Name="StatisticsPanel" Visibility="Collapsed"
                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <TextBlock Text="统计" FontSize="{DynamicResource FontSizeSubtitle}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,10"/>
                            <Border Background="{DynamicResource CardBrush}" CornerRadius="14" Padding="14,12" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="总体概览" FontSize="{DynamicResource FontSizeBody}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,8"/>
                                    <UniformGrid Columns="3">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding StatisticsViewModel.TotalTasks}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center"/>
                                            <TextBlock Text="总任务" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding StatisticsViewModel.CompletedTasks}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}" HorizontalAlignment="Center"/>
                                            <TextBlock Text="已完成" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding StatisticsViewModel.OverdueTasks}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource DangerBrush}" HorizontalAlignment="Center"/>
                                            <TextBlock Text="已过期" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </UniformGrid>
                                </StackPanel>
                            </Border>

                            <Border Background="{DynamicResource CardBrush}" CornerRadius="14" Padding="14,12" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="近 7 天完成" FontSize="{DynamicResource FontSizeBody}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,10"/>
                                    <ItemsControl ItemsSource="{Binding StatisticsViewModel.DailyStats}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><UniformGrid Columns="7"/></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel HorizontalAlignment="Center" Margin="3,0">
                                                    <Grid Height="72" VerticalAlignment="Bottom">
                                                        <Border Height="64" VerticalAlignment="Bottom" Width="20" CornerRadius="5" Background="{DynamicResource SurfacePressedBrush}"/>
                                                        <Border Height="{Binding CompletionRate, Converter={StaticResource Multiply}, ConverterParameter=60}"
                                                                MinHeight="4" VerticalAlignment="Bottom" Width="20" CornerRadius="5"
                                                                Background="{DynamicResource AccentGradientBrush}"/>
                                                    </Grid>
                                                    <TextBlock Text="{Binding CompletedTasks}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,5,0,1"/>
                                                    <TextBlock Text="{Binding DateLabel}" FontSize="9" Foreground="{DynamicResource TextTertiaryBrush}" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- v5.3 年度热力图 -->
                            <Border Background="{DynamicResource CardBrush}" CornerRadius="14" Padding="14,12" Margin="0,0,0,12">
                                <StackPanel>
                                    <Grid>
                                        <TextBlock Text="年度热力图" FontSize="{DynamicResource FontSizeBody}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button Content="年度报告" Style="{StaticResource SecondaryButton}" Padding="9,2"
                                                    Click="YearReport_Click" ToolTip="生成可保存分享的年度报告卡"/>
                                            <Button Content="‹" Style="{StaticResource SecondaryButton}" Padding="8,2" Margin="7,0,0,0"
                                                    Click="HeatmapPrevYear_Click" ToolTip="上一年"/>
                                            <TextBlock Text="{Binding StatisticsViewModel.HeatmapYear}"
                                                       FontSize="12.5" FontWeight="Bold"
                                                       Foreground="{DynamicResource TextBrush}"
                                                       VerticalAlignment="Center" Margin="8,0"/>
                                            <Button Content="›" Style="{StaticResource SecondaryButton}" Padding="8,2"
                                                    Click="HeatmapNextYear_Click" ToolTip="下一年"/>
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="{Binding StatisticsViewModel.HeatmapSummaryText}"
                                               FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                                    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                                  VerticalScrollBarVisibility="Disabled" Margin="0,10,0,0"
                                                  PreviewMouseWheel="HeatmapScroll_PreviewMouseWheel">
                                        <ItemsControl ItemsSource="{Binding StatisticsViewModel.YearHeatmap}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel Orientation="Vertical" Height="105"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Width="13" Height="13" CornerRadius="3" Margin="1"
                                                            Background="{Binding Converter={StaticResource HeatBrush}}"
                                                            ToolTip="{Binding ToolTip}"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                    <!-- 图例 -->
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
                                        <TextBlock Text="少" FontSize="9" Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <ItemsControl ItemsSource="{Binding StatisticsViewModel.HeatmapLegend}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Width="11" Height="11" CornerRadius="2.5" Margin="1"
                                                            Background="{Binding Converter={StaticResource HeatBrush}}"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="多" FontSize="9" Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- 近 30 天完成趋势折线图 -->
                            <Border Background="{DynamicResource CardBrush}" CornerRadius="14" Padding="14,12" Margin="0,0,0,12">
                                <StackPanel>
                                    <Grid>
                                        <TextBlock Text="近 30 天完成趋势" FontSize="{DynamicResource FontSizeBody}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                                        <TextBlock x:Name="TrendRangeText" FontSize="10" Foreground="{DynamicResource TextTertiaryBrush}" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <controls:LineChart x:Name="ThirtyDayChart" Height="150" Margin="0,10,0,0"/>
                                    <TextBlock x:Name="TrendTotalText" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Right" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Background="{DynamicResource CardBrush}" CornerRadius="14" Padding="14,12">
                                <StackPanel>
                                    <TextBlock Text="今日" FontSize="{DynamicResource FontSizeBody}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,8"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid Width="84" Height="84">
                                            <controls:CircularProgress Size="84" StrokeThickness="9"
                                                                       Progress="{Binding TodayProgressRate}"
                                                                       BackgroundBrush="{DynamicResource SurfacePressedBrush}">
                                                <controls:CircularProgress.Style>
                                                    <Style TargetType="controls:CircularProgress">
                                                        <Setter Property="ProgressBrush" Value="{DynamicResource AccentGradientBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsOverachieving}" Value="True">
                                                                <Setter Property="ProgressBrush" Value="{DynamicResource WarningBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </controls:CircularProgress.Style>
                                            </controls:CircularProgress>
                                            <TextBlock Text="{Binding TodayProgressRate, Converter={StaticResource FractionToPercent}}"
                                                       FontSize="15" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Grid>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="18,0,0,0">
                                            <StackPanel Orientation="Horizontal" Margin="0,3">
                                                <TextBlock Text="{Binding TodayDoneText}" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}"/>
                                                <TextBlock Text=" 今日完成" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <!-- R62：与侧边栏/仪表卡同源，旧双公式分母已废弃；顺带展示今日输入 -->
                                            <TextBlock Text="{Binding TodayTypingText}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ===== 成就页（V2-W7）===== -->
                    <Grid x:Name="AchievementsPanel" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="成就徽章" FontSize="{DynamicResource FontSizeSubtitle}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                            <Border Background="{DynamicResource WarningSoftBrush}" CornerRadius="999" Padding="8,2" Margin="8,0,0,0">
                                <TextBlock x:Name="AchievementsCountText" Text="0 / 0 已解锁" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource ComboBrush}"/>
                            </Border>
                        </StackPanel>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="AchievementsList">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="152" Margin="0,0,10,10" CornerRadius="14"
                                                Background="{DynamicResource CardBrush}" Padding="12,12"
                                               >
                                            <StackPanel>
                                                <Grid Width="54" Height="54" HorizontalAlignment="Left">
                                                    <Ellipse x:Name="BadgeCircle" Fill="{DynamicResource SurfaceHoverBrush}"/>
                                                    <TextBlock Text="{Binding Icon}" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Grid>
                                                <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextBrush}" Margin="0,9,0,0"/>
                                                <TextBlock Text="{Binding Description}" FontSize="10"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           TextWrapping="Wrap" Margin="0,2,0,0" MinHeight="26"/>
                                                <TextBlock x:Name="BadgeStatus" Text="未解锁" FontSize="9.5"
                                                           Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Unlocked}" Value="True">
                                                <Setter TargetName="BadgeCircle" Property="Fill" Value="{DynamicResource AccentSoftBrush}"/>
                                                <Setter TargetName="BadgeStatus" Property="Text" Value="已解锁 ✓"/>
                                                <Setter TargetName="BadgeStatus" Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                                <Setter TargetName="BadgeStatus" Property="FontWeight" Value="SemiBold"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Unlocked}" Value="False">
                                                <Setter TargetName="BadgeCircle" Property="Opacity" Value="0.45"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>

                    <!-- ===== v5.3 回收站页 ===== -->
                    <DockPanel x:Name="TrashPanel" Visibility="Collapsed">
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="回收站" FontSize="{DynamicResource FontSizeSubtitle}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                                <Border Background="{DynamicResource SurfaceHoverBrush}" CornerRadius="999" Padding="8,2" Margin="8,0,0,0">
                                    <TextBlock Text="{Binding DeletedTasks.Count, Mode=OneWay}" FontSize="10.5" FontWeight="Bold"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </Border>
                                <TextBlock Text="删除的任务保留 30 天，之后自动清除"
                                           FontSize="10.5" Foreground="{DynamicResource TextTertiaryBrush}"
                                           VerticalAlignment="Center" Margin="10,0,0,0"/>
                            </StackPanel>
                            <Button Content="清空回收站" HorizontalAlignment="Right"
                                    Style="{StaticResource SecondaryButton}" Padding="12,5"
                                    Click="PurgeAllTrash_Click"/>
                        </Grid>

                        <ListBox x:Name="TrashList" ItemsSource="{Binding DeletedTasks}"
                                 Style="{StaticResource GlassListBox}" BorderThickness="0"
                                 HorizontalContentAlignment="Stretch">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource CardBrush}" CornerRadius="12" Padding="13,11" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <controls:AppIcon Glyph="{x:Static controls:Icons.Delete}" FontSize="14"
                                                              Foreground="{DynamicResource DangerBrush}"
                                                              VerticalAlignment="Center" Margin="0,0,10,0"/>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextBrush}"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                    <TextBlock Text="{Binding DeletedAgoText}" FontSize="10.5"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                    <TextBlock Text="{Binding TagsDisplay}" FontSize="10.5"
                                                               Foreground="{DynamicResource AccentBrush}" Margin="9,0,0,0"
                                                               Visibility="{Binding TagsDisplay, Converter={StaticResource EmptyToVis}}"/>
                                                </StackPanel>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Content="恢复" Style="{StaticResource PrimaryButton}" Padding="12,4"
                                                        Command="{Binding DataContext.RestoreFromTrashCommand,
                                                                 RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"/>
                                                <Button Content="彻底删除" Style="{StaticResource SecondaryButton}" Padding="12,4" Margin="7,0,0,0"
                                                        Command="{Binding DataContext.PurgeFromTrashCommand,
                                                                 RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>

                    <!-- ===== 专注页（V2-W6 沉浸式场景，刻意与明暗主题无关的深色氛围）===== -->
                    <Grid x:Name="FocusPanel" Visibility="Collapsed">
                        <Border Background="#0D1526" CornerRadius="16"/>
                        <Grid Margin="24,16">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- 页头 -->
                            <StackPanel Grid.Row="0" Orientation="Horizontal">
                                <TextBlock Text="🍅" FontSize="14" VerticalAlignment="Center"/>
                                <TextBlock Text=" 专注" FontSize="{DynamicResource FontSizeSubtitle}" FontWeight="SemiBold" Foreground="#F1F5F9" VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- 环 + 状态 -->
                            <StackPanel Grid.Row="1" VerticalAlignment="Center">
                                <Grid HorizontalAlignment="Center">
                                    <!-- 氛围光晕 -->
                                    <Ellipse Width="330" Height="330" IsHitTestVisible="False">
                                        <Ellipse.Fill>
                                            <RadialGradientBrush>
                                                <GradientStop Color="#2E6366F1" Offset="0"/>
                                                <GradientStop Color="#006366F1" Offset="1"/>
                                            </RadialGradientBrush>
                                        </Ellipse.Fill>
                                    </Ellipse>
                                    <controls:CircularProgress x:Name="FocusRing" Size="240" StrokeThickness="15" Progress="0"
                                                               ProgressBrush="{DynamicResource AccentGradientBrush}"
                                                               BackgroundBrush="#223047"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock x:Name="FocusTimerText" Text="25:00" FontSize="46" FontWeight="SemiBold"
                                                   Foreground="#F1F5F9" HorizontalAlignment="Center"/>
                                        <TextBlock x:Name="FocusStateText" Text="准备开始专注" FontSize="12"
                                                   Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>

                                <!-- 回合圆点 -->
                                <StackPanel x:Name="SessionDots" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0"/>
                                <TextBlock Text="完成 4 个回合为一组 · 组间休息 5 分钟"
                                           FontSize="10" Foreground="#475569" HorizontalAlignment="Center" Margin="0,8,0,0"/>

                                <!-- 绑定任务 chip -->
                                <Border Background="#16203A" CornerRadius="999" Padding="14,7" Margin="40,14,40,0"
                                        BorderBrush="#26324B" BorderThickness="1">
                                    <ComboBox x:Name="FocusTaskCombo" FontSize="11.5"
                                              Background="Transparent" BorderThickness="0" Foreground="#CBD5E1"
                                              DisplayMemberPath="Title"
                                              ToolTip="专注完成时自动累计该任务实际用时"/>
                                </Border>

                                <!-- 控制按钮 -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                                    <Button x:Name="FocusStartButton" Style="{StaticResource PrimaryButton}" Padding="26,11" Click="FocusStart_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <controls:AppIcon Glyph="{x:Static controls:Icons.Play}" FontSize="11" Foreground="White" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                            <TextBlock x:Name="FocusStartLabel" Text="开始专注" FontSize="13" Foreground="White" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource SecondaryButton}" Padding="16,10" Click="FocusPause_Click" Margin="8,0,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <controls:AppIcon Glyph="{x:Static controls:Icons.Pause}" FontSize="9" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                            <TextBlock Text="暂停" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource SecondaryButton}" Padding="16,10" Click="FocusStop_Click" Margin="8,0,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <controls:AppIcon Glyph="{x:Static controls:Icons.Stop}" FontSize="9" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                            <TextBlock Text="停止" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                <TextBlock Text="Space 开始 / 暂停 · Esc 停止 · 中断不计经验"
                                           FontSize="9.5" Foreground="#33415E" HorizontalAlignment="Center" Margin="0,12,0,0"/>

                                <!-- v5.6 白噪音 -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                                    <TextBlock Text="白噪音" FontSize="10.5" Foreground="#64748B"
                                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <Button x:Name="NoiseRainBtn" Content="雨声" Click="NoiseKind_Click" Tag="rain"
                                            Style="{StaticResource SecondaryButton}" Padding="10,4"/>
                                    <Button x:Name="NoiseStreamBtn" Content="溪流" Click="NoiseKind_Click" Tag="stream"
                                            Style="{StaticResource SecondaryButton}" Padding="10,4" Margin="6,0,0,0"/>
                                    <Button x:Name="NoiseFireBtn" Content="篝火" Click="NoiseKind_Click" Tag="fire"
                                            Style="{StaticResource SecondaryButton}" Padding="10,4" Margin="6,0,0,0"/>
                                    <Button x:Name="NoiseWhiteBtn" Content="白噪" Click="NoiseKind_Click" Tag="white"
                                            Style="{StaticResource SecondaryButton}" Padding="10,4" Margin="6,0,0,0"/>
                                    <Slider x:Name="NoiseVolumeSlider" Width="90" Minimum="5" Maximum="100"
                                            ValueChanged="NoiseVolume_ValueChanged"
                                            LostMouseCapture="NoiseVolume_LostMouseCapture"
                                            VerticalAlignment="Center" Margin="12,0,0,0"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- 底部统计条 -->
                            <Border Grid.Row="2" Background="#16203A" CornerRadius="16" Padding="8,12"
                                    BorderBrush="#26324B" BorderThickness="1">
                                <UniformGrid Columns="4">
                                    <StackPanel>
                                        <TextBlock x:Name="StatPomodoros" Text="0" FontSize="17" FontWeight="Bold" Foreground="#F1F5F9" HorizontalAlignment="Center"/>
                                        <TextBlock Text="今日番茄" FontSize="9.5" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock x:Name="StatMinutes" Text="0 分" FontSize="17" FontWeight="Bold" Foreground="#F1F5F9" HorizontalAlignment="Center"/>
                                        <TextBlock Text="专注时长" FontSize="9.5" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock x:Name="StatInterrupted" Text="0" FontSize="17" FontWeight="Bold" Foreground="#FBBF24" HorizontalAlignment="Center"/>
                                        <TextBlock Text="中断次数" FontSize="9.5" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock x:Name="StatRounds" Text="0/4" FontSize="17" FontWeight="Bold" Foreground="#818CF8" HorizontalAlignment="Center"/>
                                        <TextBlock Text="当前回合" FontSize="9.5" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </UniformGrid>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>

            <!-- v5.3 删除撤销条（Snackbar） -->
            <Border Grid.Row="0" Grid.RowSpan="3" Panel.ZIndex="99"
                    Visibility="{Binding IsUndoBarVisible, Converter={StaticResource BoolToVis}}"
                    HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,26">
                <Border Background="#E6202A33" CornerRadius="999" Padding="16,8">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.35"/>
                    </Border.Effect>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding UndoMessage}" FontSize="12" Foreground="#F1F5F9"
                                   VerticalAlignment="Center"/>
                        <Button Content="撤销" Cursor="Hand" FontSize="12" FontWeight="Bold"
                                Foreground="#7DD3FC" Background="Transparent"
                                BorderThickness="0" Padding="10,0" Margin="6,0,-4,0"
                                Command="{Binding UndoDeleteCommand}"/>
                    </StackPanel>
                </Border>
            </Border>

            <!-- 覆盖层：粒子 + 升级横幅 -->
            <Canvas Grid.Row="0" Grid.RowSpan="3" x:Name="ParticleLayer" IsHitTestVisible="False" Panel.ZIndex="100"/>
            <Border Grid.Row="0" Grid.RowSpan="3" x:Name="LevelUpBanner" Panel.ZIndex="101" Visibility="Collapsed"
                    HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,90,0,0"
                    Background="{DynamicResource CardBrush}"
                    BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1.5"
                    CornerRadius="14" Padding="20,13" IsHitTestVisible="False"
                    controls:Elevation.Level="3">
                <StackPanel>
                    <TextBlock x:Name="LevelUpTitleText" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="LevelUpSubText" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
