<Window x:Class="TodoSidebar.FullWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:TodoSidebar.ViewModels"
        xmlns:helpers="clr-namespace:TodoSidebar.Helpers"
        xmlns:controls="clr-namespace:TodoSidebar.Controls"
        Title="每日任务"
        Width="450"
        Height="700"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStyle="None">
    
    <Window.Resources>
        <!-- 优先级选择器样式 -->
        <Style x:Key="PriorityComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <!-- 头部图标按钮样式 -->
        <Style x:Key="HeaderIconButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Width="{TemplateBinding Width}"
                                Height="{TemplateBinding Height}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#18000000"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 工具栏文字按钮样式 -->
        <Style x:Key="ToolbarTextButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#12000000"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource GlassBrush}"
            CornerRadius="12"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 顶部栏（可拖动） -->
            <Border Grid.Row="0" 
                    Background="{DynamicResource GlassLightBrush}"
                    Padding="0"
                    CornerRadius="12,12,0,0"
                    BorderThickness="0,0,0,1"
                    BorderBrush="{DynamicResource BorderBrush}"
                    Cursor="SizeAll"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <DockPanel>
                    <!-- 工具栏（底部，先渲染放在DockPanel底部） -->
                    <Border DockPanel.Dock="Bottom"
                            Background="Transparent"
                            Padding="16,6"
                            BorderThickness="0,1,0,0"
                            BorderBrush="{DynamicResource BorderBrush}">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="⬆ 同步上传"
                                    Style="{StaticResource ToolbarTextButton}"
                                    Command="{Binding SyncViewModel.UploadCommand}"
                                    ToolTip="上传到云端"/>
                            <Button Content="⬇ 同步下载"
                                    Style="{StaticResource ToolbarTextButton}"
                                    Command="{Binding SyncViewModel.DownloadCommand}"
                                    ToolTip="从云端下载"
                                    Margin="4,0,0,0"/>
                            <Button Content="⚙ 设置"
                                    Style="{StaticResource ToolbarTextButton}"
                                    Click="SettingsButton_Click"
                                    ToolTip="设置"/>
                        </StackPanel>
                    </Border>

                    <!-- 标题行 -->
                    <Border DockPanel.Dock="Top" Background="Transparent" Padding="20,14">
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <Border Background="{DynamicResource AccentBrush}"
                                        CornerRadius="10"
                                        Width="36"
                                        Height="36"
                                        Margin="0,0,12,0">
                                    <TextBlock Text="✓"
                                               Foreground="White"
                                               FontSize="18"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="每日任务"
                                               FontSize="17"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextBrush}"/>
                                    <TextBlock FontSize="11"
                                               Foreground="{DynamicResource TextSecondaryBrush}">
                                        <Run Text="共 "/>
                                        <Run Text="{Binding CurrentTasksCount, Mode=OneWay}" FontWeight="SemiBold"/>
                                        <Run Text=" 项待办"/>
                                    </TextBlock>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button Content="🚪"
                                        Style="{StaticResource HeaderIconButton}"
                                        Click="LogoutButton_Click"
                                        ToolTip="退出登录"/>
                                <Button Content="◀"
                                        Style="{StaticResource HeaderIconButton}"
                                        Click="CollapseToSidebar_Click"
                                        ToolTip="收起为侧边栏"
                                        Margin="2,0,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 升级等级条 -->
                    <Border DockPanel.Dock="Top"
                            Background="{DynamicResource GlassLightBrush}"
                            CornerRadius="8"
                            Padding="12,7"
                            Margin="16,0,16,12">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding LevelDisplay}"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextBrush}"/>
                                    <TextBlock Text="{Binding ComboDisplay}"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               Foreground="#FF8A00"
                                               VerticalAlignment="Center"
                                               Margin="6,0,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding LevelProgressText}"
                                               FontSize="10"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               VerticalAlignment="Center"/>
                                    <Button Content="🏅"
                                            Click="BrowseBadges_Click"
                                            ToolTip="成就图鉴"
                                            Width="26"
                                            Height="26"
                                            FontSize="13"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Cursor="Hand"
                                            Margin="8,0,0,0"/>
                                </StackPanel>
                            </Grid>
                            <ProgressBar Margin="0,6,0,0"
                                         Height="6"
                                         Minimum="0"
                                         Maximum="1"
                                         Value="{Binding LevelProgress}"
                                         Foreground="{DynamicResource AccentBrush}"
                                         Background="{DynamicResource BorderBrush}"
                                         BorderThickness="0"/>
                        </StackPanel>
                    </Border>
                </DockPanel>
            </Border>

            <!-- Tab 切换 -->
            <Border Grid.Row="1" 
                    Background="{DynamicResource GlassBrush}"
                    Padding="12,8"
                    BorderThickness="0,0,0,1"
                    BorderBrush="{DynamicResource BorderBrush}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <RadioButton x:Name="TabDaily" Content="每日" 
                                 Style="{StaticResource TabRadioButton}"
                                 IsChecked="True"
                                 Checked="Tab_Checked"/>
                    <RadioButton x:Name="TabDeadline" Content="截止" 
                                 Style="{StaticResource TabRadioButton}"
                                 Checked="Tab_Checked"/>
                    <RadioButton x:Name="TabHistory" Content="历史" 
                                 Style="{StaticResource TabRadioButton}"
                                 Checked="Tab_Checked"/>
                    <RadioButton x:Name="TabStatistics" Content="统计" 
                                 Style="{StaticResource TabRadioButton}"
                                 Checked="Tab_Checked"/>
                    <RadioButton x:Name="TabFocus" Content="🍅 专注" 
                                 Style="{StaticResource TabRadioButton}"
                                 Checked="Tab_Checked"/>
                </StackPanel>
            </Border>

            <!-- 内容区域 -->
            <Grid Grid.Row="2" Background="Transparent">
                <!-- 每日任务 -->
                <DockPanel x:Name="DailyPanel" 
                           Visibility="{Binding IsChecked, ElementName=TabDaily, Converter={StaticResource BoolToVis}}"
                           Margin="16,12">
                    <!-- 计数器 -->
                    <Border DockPanel.Dock="Top" 
                            Background="{DynamicResource CardBrush}"
                            CornerRadius="8"
                            Padding="12,8"
                            Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="今日任务" 
                                       Foreground="{DynamicResource TextBrush}"
                                       FontSize="14"
                                       VerticalAlignment="Center"/>
                            <Border Background="{DynamicResource AccentBrush}"
                                    CornerRadius="10"
                                    Padding="8,4"
                                    Margin="8,0,0,0">
                                <TextBlock Text="{Binding DailyTasksCount}"
                                           Foreground="White"
                                           FontSize="12"
                                           FontWeight="Bold"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- 今日挑战 -->
                    <Border DockPanel.Dock="Top"
                            Background="{DynamicResource CardBrush}"
                            CornerRadius="8"
                            Padding="12,8"
                            Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="🎯 今日挑战"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextBrush}"/>
                            <ItemsControl x:Name="ChallengeList" Margin="0,6,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,3,0,3"
                                                CornerRadius="6"
                                                Background="{DynamicResource GlassLightBrush}"
                                                Padding="8,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Icon}"
                                                           FontSize="14"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,8,0"/>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Title}"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource TextBrush}"/>
                                                    <TextBlock Text="{Binding ProgressText}"
                                                               FontSize="10"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding StatusText}"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    
                    <ListBox ItemsSource="{Binding DailyTasks}"
                             Style="{StaticResource GlassListBox}"
                             ItemTemplate="{StaticResource TaskCardTemplate}"
                             x:Name="DailyTasksListBox"
                             AllowDrop="True"
                             Drop="TaskListBox_Drop"
                             DragOver="TaskListBox_DragOver"
                             PreviewMouseLeftButtonDown="TaskListBox_PreviewMouseLeftButtonDown"
                             PreviewMouseMove="TaskListBox_PreviewMouseMove"
                             MouseDoubleClick="TaskListBox_MouseDoubleClick"/>
                </DockPanel>

                <!-- 截止任务 -->
                <DockPanel x:Name="DeadlinePanel" 
                           Visibility="{Binding IsChecked, ElementName=TabDeadline, Converter={StaticResource BoolToVis}}"
                           Margin="16,12">
                    <!-- 计数器 -->
                    <Border DockPanel.Dock="Top" 
                            Background="{DynamicResource CardBrush}"
                            CornerRadius="8"
                            Padding="12,8"
                            Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="截止任务" 
                                       Foreground="{DynamicResource TextBrush}"
                                       FontSize="14"
                                       VerticalAlignment="Center"/>
                            <Border Background="{DynamicResource DangerBrush}"
                                    CornerRadius="10"
                                    Padding="8,4"
                                    Margin="8,0,0,0">
                                <TextBlock Text="{Binding DeadlineTasksCount}"
                                           Foreground="White"
                                           FontSize="12"
                                           FontWeight="Bold"/>
                            </Border>
                        </StackPanel>
                    </Border>
                    
                    <ListBox ItemsSource="{Binding DeadlineTasks}"
                             Style="{StaticResource GlassListBox}"
                             ItemTemplate="{StaticResource DeadlineTaskCardTemplate}"
                             x:Name="DeadlineTasksListBox"
                             AllowDrop="True"
                             Drop="TaskListBox_Drop"
                             DragOver="TaskListBox_DragOver"
                             PreviewMouseLeftButtonDown="TaskListBox_PreviewMouseLeftButtonDown"
                             PreviewMouseMove="TaskListBox_PreviewMouseMove"
                             MouseDoubleClick="TaskListBox_MouseDoubleClick"/>
                </DockPanel>

                <!-- 历史记录 -->
                <DockPanel x:Name="HistoryPanel" 
                           Visibility="{Binding IsChecked, ElementName=TabHistory, Converter={StaticResource BoolToVis}}"
                           Margin="16,12">
                    <!-- 计数器 -->
                    <Border DockPanel.Dock="Top" 
                            Background="{DynamicResource CardBrush}"
                            CornerRadius="8"
                            Padding="12,8"
                            Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="历史记录" 
                                       Foreground="{DynamicResource TextBrush}"
                                       FontSize="14"
                                       VerticalAlignment="Center"/>
                            <Border Background="{DynamicResource TextSecondaryBrush}"
                                    CornerRadius="10"
                                    Padding="8,4"
                                    Margin="8,0,0,0">
                                <TextBlock Text="{Binding HistoryTasksCount}"
                                           Foreground="White"
                                           FontSize="12"
                                           FontWeight="Bold"/>
                            </Border>
                        </StackPanel>
                    </Border>
                    
                    <ListBox ItemsSource="{Binding HistoryTasks}"
                             Style="{StaticResource GlassListBox}"
                             ItemTemplate="{StaticResource HistoryTaskCardTemplate}"/>
                </DockPanel>

                                <!-- 统计 -->
                <ScrollViewer x:Name="StatisticsPanel" 
                              Visibility="{Binding IsChecked, ElementName=TabStatistics, Converter={StaticResource BoolToVis}}"
                              Margin="16,12">
                    <StackPanel>
                        <!-- 总体概览 -->
                        <Border Background="{DynamicResource CardBrush}"
                                CornerRadius="8"
                                Padding="12,8"
                                Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="📈 总体概览" 
                                           Foreground="{DynamicResource TextBrush}"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,8"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding StatisticsViewModel.TotalTasks}" 
                                                   FontSize="20"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource AccentBrush}"
                                                   HorizontalAlignment="Center"/>
                                        <TextBlock Text="总任务" 
                                                   FontSize="11"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   HorizontalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding StatisticsViewModel.CompletedTasks}" 
                                                   FontSize="20"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource SuccessBrush}"
                                                   HorizontalAlignment="Center"/>
                                        <TextBlock Text="已完成" 
                                                   FontSize="11"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   HorizontalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding StatisticsViewModel.OverdueTasks}" 
                                                   FontSize="20"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource DangerBrush}"
                                                   HorizontalAlignment="Center"/>
                                        <TextBlock Text="已过期" 
                                                   FontSize="11"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                        
                        <!-- 今日统计 -->
                        <Border Background="{DynamicResource CardBrush}"
                                CornerRadius="8"
                                Padding="12,8"
                                Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="📅 今日统计" 
                                           Foreground="{DynamicResource TextBrush}"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,8"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding StatisticsViewModel.TodayTotal}" 
                                                   FontSize="20"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource AccentBrush}"
                                                   HorizontalAlignment="Center"/>
                                        <TextBlock Text="今日任务" 
                                                   FontSize="11"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   HorizontalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding StatisticsViewModel.TodayCompleted}" 
                                                   FontSize="20"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource SuccessBrush}"
                                                   HorizontalAlignment="Center"/>
                                        <TextBlock Text="已完成" 
                                                   FontSize="11"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                        
                        <!-- 连续完成天数 -->
                        <Border Background="{DynamicResource CardBrush}"
                                CornerRadius="8"
                                Padding="12,8"
                                Margin="0,0,0,12">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="{Binding StatisticsViewModel.StreakDays}" 
                                           FontSize="28"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource WarningBrush}"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="🔥 连续完成天数" 
                                           FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- 专注页（番茄钟） -->
                <ScrollViewer x:Name="FocusPanel"
                              Visibility="{Binding IsChecked, ElementName=TabFocus, Converter={StaticResource BoolToVis}}"
                              Margin="16,12"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <!-- 子页面标题 -->
                        <TextBlock Text="🍅 专注"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}"/>
                        <TextBlock Text="专注 25 分钟，收获经验与专注时长"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,2,0,0"/>

                        <!-- 番茄环 + 计时 -->
                        <controls:CircularProgress x:Name="FocusRing"
                                                   Size="150"
                                                   StrokeThickness="12"
                                                   Progress="0"
                                                   ProgressBrush="{DynamicResource AccentBrush}"
                                                   BackgroundBrush="{DynamicResource BorderBrush}"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,16,0,0"/>
                        <TextBlock x:Name="FocusTimerText"
                                   Text="25:00"
                                   FontSize="34"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,10,0,0"/>
                        <TextBlock x:Name="FocusStateText"
                                   Text="🍅 准备开始专注"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,4,0,0"/>

                        <!-- 任务绑定 -->
                        <Border Background="{DynamicResource CardBrush}"
                                CornerRadius="8"
                                Padding="10,8"
                                Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="绑定任务（可选）"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <ComboBox x:Name="FocusTaskCombo"
                                          FontSize="12"
                                          Margin="0,6,0,0"
                                          DisplayMemberPath="Title"
                                          ToolTip="专注完成时自动累计该任务实际用时"/>
                            </StackPanel>
                        </Border>

                        <!-- 控制按钮 -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0">
                            <Button x:Name="FocusStartButton"
                                    Content="▶ 开始专注"
                                    Style="{StaticResource ToolbarTextButton}"
                                    Click="FocusStart_Click"/>
                            <Button Content="⏸ 暂停"
                                    Style="{StaticResource ToolbarTextButton}"
                                    Click="FocusPause_Click"
                                    Margin="6,0,0,0"/>
                            <Button Content="⏹ 停止"
                                    Style="{StaticResource ToolbarTextButton}"
                                    Click="FocusStop_Click"
                                    Margin="6,0,0,0"/>
                        </StackPanel>

                        <!-- 今日专注统计 -->
                        <Border Background="{DynamicResource CardBrush}"
                                CornerRadius="8"
                                Padding="12,10"
                                Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock x:Name="FocusTodayText"
                                           Text="今日番茄：0 · 专注 0 分钟"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextBrush}"/>
                                <TextBlock x:Name="FocusRoundText"
                                           Text="本轮：0/4"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- 底部添加栏 -->
            <Border Grid.Row="3" 
                    Background="{DynamicResource GlassLightBrush}"
                    Padding="16,12"
                    CornerRadius="0,0,12,12"
                    BorderThickness="0,1,0,0"
                    BorderBrush="{DynamicResource BorderBrush}">
                <StackPanel>
                    <!-- 输入框和添加按钮 -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TaskInput"
                                 Text="{Binding NewTaskTitle, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource GlassTextBox}"/>
                        <Button Grid.Column="1"
                                Content="+ 添加"
                                Click="AddTaskButton_Click"
                                Style="{StaticResource PrimaryButton}"
                                Margin="10,0,0,0"/>
                    </Grid>
                    
                    <!-- 优先级选择 -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="优先级:" 
                                   Foreground="{DynamicResource TextBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <RadioButton Content="高" 
                                         Tag="High"
                                         Foreground="{StaticResource PriorityHighBrush}"
                                         Margin="0,0,15,0"
                                         Checked="Priority_Checked"/>
                            <RadioButton Content="中" 
                                         Tag="Medium"
                                         Foreground="{StaticResource PriorityMediumBrush}"
                                         IsChecked="True"
                                         Margin="0,0,15,0"
                                         Checked="Priority_Checked"/>
                            <RadioButton Content="低" 
                                         Tag="Low"
                                         Foreground="{StaticResource PriorityLowBrush}"
                                         Checked="Priority_Checked"/>
                        </StackPanel>
                    </Grid>
                    
                    <!-- 截止日期选择（仅截止任务Tab显示） -->
                    <DatePicker x:Name="DeadlinePicker"
                                SelectedDate="{Binding NewTaskDeadline}"
                                Visibility="{Binding IsChecked, ElementName=TabDeadline, Converter={StaticResource BoolToVis}}"
                                Margin="0,0,0,10"/>
                </StackPanel>
            </Border>

            <!-- 升级粒子层 -->
            <Canvas x:Name="ParticleLayer"
                    IsHitTestVisible="False"
                    Panel.ZIndex="100"/>

            <!-- 升级横幅 -->
            <Border x:Name="LevelUpBanner"
                    Panel.ZIndex="101"
                    Visibility="Collapsed"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Margin="0,100,0,0"
                    Background="{DynamicResource GlassLightBrush}"
                    BorderBrush="{DynamicResource AccentBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="18,12"
                    IsHitTestVisible="False">
            <StackPanel>
                <TextBlock x:Name="LevelUpTitleText"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextBrush}"
                           HorizontalAlignment="Center"/>
                <TextBlock x:Name="LevelUpSubText"
                           FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,4,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
    </Border>
</Window>
