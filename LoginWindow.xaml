<Window x:Class="TodoSidebar.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:TodoSidebar.Controls"
        Title="登录 - TodoSidebar"
        Width="380"
        Height="520"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Topmost="True">

    <Border Background="{DynamicResource GlassBrush}"
            CornerRadius="16"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.22"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ===== 品牌渐变头部（可拖动）===== -->
            <Border Grid.Row="0"
                    CornerRadius="16,16,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#FF6366F1" Offset="0"/>
                        <GradientStop Color="#FF8B5CF6" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <StackPanel Margin="28,30,28,26">
                        <Border Background="#33FFFFFF"
                                CornerRadius="12"
                                Width="48" Height="48"
                                HorizontalAlignment="Left">
                            <controls:AppIcon Glyph="{x:Static controls:Icons.CheckMark}"
                                              Foreground="White" FontSize="22"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="每日任务"
                                   Foreground="White"
                                   FontSize="21" FontWeight="Bold"
                                   Margin="0,14,0,0"/>
                        <TextBlock Text="同步你的待办事项，从今天开始"
                                   Foreground="#CCFFFFFF"
                                   FontSize="12"
                                   Margin="0,4,0,0"/>
                    </StackPanel>

                    <Button Click="CloseButton_Click"
                            Width="32" Height="32"
                            HorizontalAlignment="Right" VerticalAlignment="Top"
                            Margin="0,12,12,0"
                            Background="Transparent" BorderThickness="0"
                            Foreground="#E6FFFFFF" Cursor="Hand"
                            ToolTip="关闭">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#33FFFFFF"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <controls:AppIcon Glyph="{x:Static controls:Icons.ChromeClose}" FontSize="11"/>
                    </Button>
                </Grid>
            </Border>

            <!-- ===== 登录表单 ===== -->
            <ScrollViewer Grid.Row="1"
                          Padding="28,22,28,10"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- 邮箱 -->
                    <TextBox x:Name="EmailTextBox"
                             FontSize="14"
                             Padding="12,10"
                             controls:Placeholder.Text="邮箱"/>

                    <!-- 密码 -->
                    <Grid Margin="0,12,0,0">
                        <Border Background="{DynamicResource CardBrush}"
                                CornerRadius="8"
                                BorderBrush="{DynamicResource BorderStrongBrush}"
                                BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <PasswordBox x:Name="PasswordBox"
                                             BorderThickness="0"
                                             Background="Transparent"
                                             Padding="12,10"
                                             FontSize="14"
                                             VerticalContentAlignment="Center"/>
                                <TextBox x:Name="PasswordRevealBox"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         Padding="12,10"
                                         FontSize="14"
                                         Visibility="Collapsed"/>
                                <ToggleButton x:Name="RevealToggle"
                                              Grid.Column="1"
                                              Width="34" Height="34"
                                              Margin="2,0,4,0"
                                              Background="Transparent" BorderThickness="0"
                                              Cursor="Hand"
                                              Checked="RevealToggle_Changed" Unchecked="RevealToggle_Changed">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                    <controls:AppIcon Glyph="{x:Static controls:Icons.RedEye}"
                                                      FontSize="13"
                                                      Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </ToggleButton>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- 记住我 + 忘记密码 -->
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox x:Name="RememberMeCheckBox"
                                  Content="记住我"
                                  FontSize="12"
                                  VerticalAlignment="Center"/>
                        <Button Content="忘记密码？"
                                Style="{StaticResource LinkButton}"
                                Grid.Column="1"
                                FontSize="12"
                                Click="ForgotPassword_Click"/>
                    </Grid>

                    <!-- 错误提示（行内 Alert） -->
                    <Border Background="{DynamicResource DangerSoftBrush}"
                            CornerRadius="8"
                            Padding="12,9"
                            Margin="0,16,0,0"
                            Visibility="{Binding Visibility, ElementName=ErrorText}">
                        <TextBlock x:Name="ErrorText"
                                   Foreground="{DynamicResource DangerBrush}"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Visibility="Collapsed"/>
                    </Border>

                    <!-- 登录按钮 -->
                    <Button x:Name="LoginButton"
                            Content="登录"
                            Style="{StaticResource PrimaryButton}"
                            Margin="0,18,0,0"
                            Padding="0,11"
                            Click="LoginButton_Click"
                            IsDefault="True"/>

                    <!-- 分隔线 -->
                    <Grid Margin="0,20,0,16">
                        <Border Height="1"
                                Background="{DynamicResource BorderStrongBrush}"
                                Opacity="0.5"
                                VerticalAlignment="Center"/>
                        <TextBlock Text="或"
                                   Background="Transparent"
                                   Padding="12,0"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                   FontSize="12"/>
                    </Grid>

                    <!-- 注册 -->
                    <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                        <TextBlock Text="没有账号？"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="12"
                                   VerticalAlignment="Center"/>
                        <Button Content="立即注册"
                                Style="{StaticResource LinkButton}"
                                FontSize="12"
                                Click="RegisterButton_Click"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- 底部安全提示 -->
            <Border Grid.Row="2"
                    Padding="20,10">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <controls:AppIcon Glyph="{x:Static controls:Icons.Lock}"
                                      FontSize="10"
                                      Foreground="{DynamicResource TextTertiaryBrush}"
                                      VerticalAlignment="Center"
                                      Margin="0,0,5,0"/>
                    <TextBlock Text="你的数据将通过加密传输和存储"
                               FontSize="10.5"
                               Foreground="{DynamicResource TextTertiaryBrush}"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
