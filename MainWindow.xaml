<Window x:Class="TodoSidebar.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:TodoSidebar.ViewModels"
        xmlns:controls="clr-namespace:TodoSidebar.Controls"
        Title="Todo Sidebar"
        Width="352"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        Left="0"
        Top="0"
        Height="820"
        Loaded="Window_Loaded">

    <!-- ===== 侧边栏按钮样式（底部 Dock 用）===== -->
    <Window.Resources>
        <Style x:Key="DockIconButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SurfacePressedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MiniPomoButton" TargetType="Button" BasedOn="{StaticResource DockIconButton}">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- 主面板 -->
        <Border x:Name="MainPanel"
                Background="{DynamicResource GlassBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,1,0"
                CornerRadius="0,18,18,0"
                Margin="0"
                Width="352">
            <Border.Effect>
                <DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.13"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ===== 头部：头像 + 问候 + 操作圆钮（扁平化，无条带）===== -->
                <Border Grid.Row="0"
                        Background="Transparent"
                        Padding="16,14,12,10"
                        Cursor="SizeAll"
                        MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <Grid>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="42" Height="42" CornerRadius="999"
                                    Background="{DynamicResource AccentGradientBrush}">
                                <controls:AppIcon Glyph="{x:Static controls:Icons.CheckMark}"
                                                  Foreground="White" FontSize="17"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center" Margin="11,0,0,0">
                                <TextBlock x:Name="GreetingText" Text="你好"
                                           FontSize="15" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextBrush}"/>
                                <TextBlock x:Name="DateTimeText" Text=""
                                           FontSize="10.5"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Style="{StaticResource HeaderIconButton}" Click="BrowseBadges_Click" ToolTip="成就图鉴" Margin="0,0,0,0">
                                <controls:AppIcon Glyph="{x:Static controls:Icons.Star}" FontSize="14"/>
                            </Button>
                            <Button Style="{StaticResource HeaderIconButton}" Click="SettingsButton_Click" ToolTip="设置" Margin="2,0,0,0">
                                <controls:AppIcon Glyph="{x:Static controls:Icons.Settings}" FontSize="13"/>
                            </Button>
                            <Button Style="{StaticResource HeaderIconButton}" Click="ExpandFullMode_Click" ToolTip="展开完整窗口" Margin="2,0,0,0">
                                <controls:AppIcon Glyph="{x:Static controls:Icons.OpenInNewWindow}" FontSize="12"/>
                            </Button>
                            <Button Style="{StaticResource HeaderIconButton}" Click="CollapseButton_Click" ToolTip="收起" Margin="2,0,0,0">
                                <controls:AppIcon Glyph="{x:Static controls:Icons.ChevronLeft}" FontSize="11"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ===== Hero：左环 ｜ 中昵称+连击 ｜ 右等级信息 ===== -->
                <Border Grid.Row="1" Background="Transparent" Padding="16,12,16,4">
                    <Border Background="{DynamicResource CardBrush}"
                            CornerRadius="16" Padding="14,12"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- 左：今日进度环 + 百分比 -->
                            <Grid Grid.Column="0" Width="58" Height="58" VerticalAlignment="Center">
                                <controls:CircularProgress Size="58" StrokeThickness="6"
                                                           Progress="{Binding TodayProgressRate}"
                                                           ProgressBrush="{DynamicResource AccentGradientBrush}"
                                                           BackgroundBrush="{DynamicResource SurfacePressedBrush}"/>
                                <TextBlock Text="{Binding TodayProgressRate, Converter={StaticResource FractionToPercent}}"
                                           FontSize="11.5" FontWeight="Bold"
                                           Foreground="{DynamicResource AccentBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>

                            <!-- 中：昵称 + 今日完成 -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="13,0,10,0">
                                <TextBlock x:Name="HeroNickname" Text=""
                                           FontSize="15" FontWeight="Bold"
                                           Foreground="{DynamicResource TextBrush}"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding TodayDoneText, StringFormat='今日完成 {0}'}"
                                           FontSize="10.5" Foreground="{DynamicResource TextTertiaryBrush}"
                                           Margin="0,5,0,0"/>
                            </StackPanel>

                            <!-- 右：等级信息（约占卡片 49% 宽） -->
                            <StackPanel Grid.Column="2" Width="142" VerticalAlignment="Center"
                                        HorizontalAlignment="Right">
                                <TextBlock Text="{Binding LevelDisplay}"
                                           FontSize="14" FontWeight="Bold"
                                           Foreground="{DynamicResource TextBrush}"
                                           TextTrimming="CharacterEllipsis"/>
                                <ProgressBar Height="6" Minimum="0" Maximum="1"
                                             Value="{Binding LevelProgress}" Margin="0,7,0,4"
                                             Foreground="{DynamicResource AccentGradientBrush}"/>
                                <TextBlock Text="{Binding LevelProgressText}"
                                           FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <!-- 连击天数（移至等级块下方） -->
                                <StackPanel Orientation="Horizontal" Margin="0,9,0,0"
                                            Visibility="{Binding ComboDisplay, Converter={StaticResource EmptyToVis}}">
                                    <controls:AppIcon Glyph="{x:Static controls:Icons.FavoriteStar}"
                                                      FontSize="10" Foreground="{DynamicResource ComboBrush}"
                                                      VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <TextBlock Text="{Binding ComboDisplay}" FontSize="10.5" FontWeight="SemiBold"
                                               Foreground="{DynamicResource ComboBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Border>

                <!-- ===== Composer / 搜索（互斥切换）===== -->
                <Grid Grid.Row="2" Background="Transparent" Margin="16,10,16,6">
                    <!-- 快速添加 -->
                    <StackPanel Visibility="{Binding IsSearchMode, Converter={StaticResource InvertedBoolToVis}}">
                        <Border Background="{DynamicResource CardBrush}"
                                CornerRadius="10"
                                BorderBrush="{DynamicResource BorderStrongBrush}"
                                BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="QuickAddInput"
                                         controls:Placeholder.Text="添加任务，回车确认…"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         Padding="14,9,44,9"
                                         FontSize="12.5"
                                         Foreground="{DynamicResource TextBrush}"
                                         VerticalContentAlignment="Center"
                                         KeyDown="QuickAddInput_KeyDown"/>
                            </Grid>
                        </Border>
                        <StackPanel Orientation="Horizontal" Margin="4,7,0,0">
                            <DatePicker x:Name="QuickDeadlinePicker" FontSize="10.5" Height="24"
                                        SelectedDateFormat="Short" Width="112"
                                        VerticalContentAlignment="Center"/>
                            <TextBlock Text="不选日期 = 每日任务" FontSize="9.5"
                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                       VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- 搜索框 -->
                    <StackPanel Orientation="Horizontal"
                                Visibility="{Binding IsSearchMode, Converter={StaticResource BoolToVis}}">
                        <Border Background="{DynamicResource CardBrush}"
                                CornerRadius="12"
                                BorderBrush="{DynamicResource BorderStrongBrush}"
                                BorderThickness="1">
                            <TextBox x:Name="SearchInput"
                                     Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}"
                                     controls:Placeholder.Text="搜索任务…"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     Width="230"
                                     Padding="12,8"
                                     FontSize="12.5"
                                     Foreground="{DynamicResource TextBrush}"
                                     VerticalContentAlignment="Center"
                                     KeyDown="SearchInput_KeyDown"/>
                        </Border>
                        <Button Content="✕" Style="{StaticResource IconButton}" Command="{Binding ClearSearchCommand}" Width="28" Height="28" Margin="6,0,0,0" ToolTip="清除搜索"/>
                    </StackPanel>
                </Grid>

                <!-- ===== 列表区（搜索结果 / 任务流 互斥）===== -->
                <Grid Grid.Row="3" Margin="0,2,0,0">
                    <ListBox x:Name="SearchResultsListBox"
                             ItemsSource="{Binding SearchResults}"
                             Style="{StaticResource GlassListBox}"
                             Margin="12,4"
                             Visibility="{Binding IsSearchMode, Converter={StaticResource BoolToVis}}"
                             MouseDoubleClick="TaskListBox_MouseDoubleClick">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource CardBrush}"
                                        CornerRadius="10"
                                        Padding="11,9"
                                        Margin="0,2"
                                        BorderThickness="3,0,0,0"
                                        BorderBrush="{Binding TypeColor}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="Medium"
                                                   Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding TypeText}" FontSize="10"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <ListBox x:Name="TaskListBox"
                             ItemsSource="{Binding CurrentTasks}"
                             Style="{StaticResource GlassListBox}"
                             Margin="12,4"
                             Visibility="{Binding IsSearchMode, Converter={StaticResource InvertedBoolToVis}}"
                             AllowDrop="True"
                             Drop="TaskListBox_Drop"
                             DragOver="TaskListBox_DragOver"
                             PreviewMouseLeftButtonDown="TaskListBox_PreviewMouseLeftButtonDown"
                             PreviewMouseMove="TaskListBox_PreviewMouseMove"
                             MouseDoubleClick="TaskListBox_MouseDoubleClick">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="TaskCard"
                                        CornerRadius="12"
                                        Padding="10,9"
                                        Margin="0,3"
                                        Cursor="Hand"
                                        MouseLeftButtonDown="TaskCard_Click">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
                                            <Setter Property="BorderThickness" Value="0,0,0,0"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Type}" Value="1">
                                                    <Setter Property="Background" Value="{DynamicResource DeadlineCardBrush}"/>
                                                    <Setter Property="BorderThickness" Value="0,0,3,0"/>
                                                    <Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}"/>
                                                </DataTrigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- 完成圆钮：单击即完成 -->
                                        <Button Grid.Column="0"
                                                Width="20"
                                                Height="20"
                                                VerticalAlignment="Center"
                                                Margin="0,0,9,0"
                                                FocusVisualStyle="{x:Null}"
                                                Command="{Binding DataContext.CompleteTaskCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="完成任务">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Grid Background="Transparent">
                                                        <Ellipse x:Name="CompleteRing"
                                                                 Stroke="{DynamicResource BorderStrongBrush}"
                                                                 StrokeThickness="1.5"/>
                                                        <controls:AppIcon x:Name="CompleteCheck"
                                                                          Glyph="{x:Static controls:Icons.CheckMark}"
                                                                          FontSize="10"
                                                                          Foreground="{DynamicResource SuccessBrush}"
                                                                          Visibility="Hidden"
                                                                          HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center"/>
                                                    </Grid>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="CompleteRing" Property="Stroke" Value="{DynamicResource SuccessBrush}"/>
                                                            <Setter TargetName="CompleteRing" Property="Fill" Value="{DynamicResource SuccessSoftBrush}"/>
                                                            <Setter TargetName="CompleteCheck" Property="Visibility" Value="Visible"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>

                                        <!-- 任务内容 -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}"
                                                       Foreground="{DynamicResource TextBrush}"
                                                       FontSize="12.5"
                                                       FontWeight="Medium"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <!-- 项目制任务显示截止日期和倒计时（软底胶囊） -->
                                            <StackPanel x:Name="DeadlineRow"
                                                        Orientation="Horizontal"
                                                        Margin="0,4,0,0"
                                                        Visibility="Collapsed">
                                                <Border Background="{DynamicResource WarningSoftBrush}"
                                                        CornerRadius="999"
                                                        Padding="7,2"
                                                        HorizontalAlignment="Left">
                                                    <StackPanel Orientation="Horizontal">
                                                        <controls:AppIcon Glyph="{x:Static controls:Icons.Recent}"
                                                                          FontSize="8"
                                                                          Foreground="{DynamicResource WarningBrush}"
                                                                          VerticalAlignment="Center"
                                                                          Margin="0,0,4,0"/>
                                                        <TextBlock Text="{Binding Deadline, StringFormat='{}{0:MM/dd}'}"
                                                                   Foreground="{DynamicResource WarningBrush}"
                                                                   FontSize="9.5"
                                                                   FontWeight="SemiBold"/>
                                                        <TextBlock Text="{Binding DeadlineUrgency}"
                                                                   Foreground="{DynamicResource WarningBrush}"
                                                                   FontSize="9.5"
                                                                   Margin="4,0,0,0"/>
                                                    </StackPanel>
                                                </Border>
                                                <Border x:Name="PriorityChipDeadline"
                                                        Background="{DynamicResource DangerSoftBrush}"
                                                        CornerRadius="999" Padding="7,2" Margin="6,0,0,0"
                                                        Visibility="Collapsed">
                                                    <TextBlock Text="高优先" FontSize="9" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource DangerBrush}"/>
                                                </Border>
                                            </StackPanel>
                                            <!-- 每日任务标签（软底胶囊） -->
                                            <StackPanel x:Name="DailyRow"
                                                        Orientation="Horizontal"
                                                        Margin="0,4,0,0">
                                                <Border Background="{DynamicResource AccentSoftBrush}"
                                                        CornerRadius="999"
                                                        Padding="7,2"
                                                        HorizontalAlignment="Left">
                                                    <TextBlock Text="每日"
                                                               FontSize="9"
                                                               Foreground="{DynamicResource AccentBrush}"
                                                               FontWeight="SemiBold"/>
                                                </Border>
                                                <Border x:Name="PriorityChipDaily"
                                                        Background="{DynamicResource DangerSoftBrush}"
                                                        CornerRadius="999" Padding="7,2" Margin="6,0,0,0"
                                                        Visibility="Collapsed">
                                                    <TextBlock Text="高优先" FontSize="9" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource DangerBrush}"/>
                                                </Border>
                                            </StackPanel>
                                            <!-- 子任务进度（点击可展开） -->
                                            <StackPanel x:Name="SubTaskRow"
                                                        Orientation="Horizontal"
                                                        Margin="0,4,0,0"
                                                        Visibility="Collapsed">
                                                <Border Background="{DynamicResource SurfacePressedBrush}"
                                                        CornerRadius="999"
                                                        Padding="7,2"
                                                        HorizontalAlignment="Left">
                                                    <StackPanel Orientation="Horizontal">
                                                        <controls:AppIcon Glyph="{x:Static controls:Icons.CheckList}"
                                                                          FontSize="8"
                                                                          Foreground="{DynamicResource AccentBrush}"
                                                                          VerticalAlignment="Center"
                                                                          Margin="0,0,4,0"/>
                                                        <TextBlock Text="{Binding SubTasksProgressText}"
                                                                   FontSize="9.5"
                                                                   Foreground="{DynamicResource AccentBrush}"
                                                                   FontWeight="SemiBold"/>
                                                    </StackPanel>
                                                </Border>
                                                <TextBlock Text="点击展开"
                                                           FontSize="9"
                                                           Foreground="{DynamicResource TextTertiaryBrush}"
                                                           VerticalAlignment="Center"
                                                           Margin="5,0,0,0"/>
                                            </StackPanel>
                                            <!-- 展开区域：子任务详情 -->
                                            <StackPanel x:Name="ExpandArea"
                                                        Visibility="Collapsed"
                                                        Margin="0,8,0,2">
                                                <ItemsControl x:Name="SubTasksList"
                                                              ItemsSource="{Binding SubTasksList}"
                                                              Margin="0,0,0,6">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                                                <CheckBox IsChecked="{Binding IsCompleted}"
                                                                          Click="SubTaskCheckBox_Click"
                                                                          Width="16" Height="16"
                                                                          Margin="0,0,6,0"/>
                                                                <TextBlock Text="{Binding Title}"
                                                                           FontSize="11"
                                                                           Foreground="{Binding IsCompleted, Converter={StaticResource SubTaskForeground}}"
                                                                           TextDecorations="{Binding IsCompleted, Converter={StaticResource SubTaskStrike}}"
                                                                           VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <Grid Margin="0,2,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Background="{DynamicResource SurfaceHoverBrush}"
                                                            CornerRadius="6"
                                                            BorderBrush="{DynamicResource BorderBrush}"
                                                            BorderThickness="1">
                                                        <TextBox x:Name="SubTaskInput"
                                                                 Text="{Binding DataContext.NewSubTaskTitle, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=PropertyChanged}"
                                                                 BorderThickness="0"
                                                                 Background="Transparent"
                                                                 Padding="8,4"
                                                                 FontSize="11"
                                                                 Foreground="{DynamicResource TextBrush}"
                                                                 VerticalContentAlignment="Center"
                                                                 Tag="{Binding}"
                                                                 KeyDown="SubTaskInput_KeyDown"/>
                                                    </Border>
                                                    <Button Grid.Column="1"
                                                            Style="{StaticResource IconButton}"
                                                            Command="{Binding DataContext.AddSubTaskCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Width="24"
                                                            Height="24"
                                                            Margin="4,0,0,0"
                                                            ToolTip="添加子任务">
                                                        <controls:AppIcon Glyph="{x:Static controls:Icons.Add}" FontSize="10"/>
                                                    </Button>
                                                </Grid>
                                                <TextBlock Text="点击收起 ▴"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           FontSize="9"
                                                           HorizontalAlignment="Center"
                                                           Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- 删除按钮：悬停卡片时显现 -->
                                        <Button x:Name="DeleteTaskButton"
                                                Grid.Column="2"
                                                Opacity="0"
                                                Width="24"
                                                Height="24"
                                                VerticalAlignment="Center"
                                                Command="{Binding DataContext.DeleteTaskCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource IconButton}"
                                                Foreground="{DynamicResource DangerBrush}"
                                                ToolTip="删除任务">
                                            <controls:AppIcon Glyph="{x:Static controls:Icons.Delete}" FontSize="11"/>
                                        </Button>
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Type}" Value="1">
                                        <Setter TargetName="DeadlineRow" Property="Visibility" Value="Visible"/>
                                        <Setter TargetName="DailyRow" Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding HasSubTasks}" Value="True">
                                        <Setter TargetName="SubTaskRow" Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Priority}" Value="High">
                                        <Setter TargetName="PriorityChipDaily" Property="Visibility" Value="Visible"/>
                                        <Setter TargetName="PriorityChipDeadline" Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <Trigger SourceName="TaskCard" Property="IsMouseOver" Value="True">
                                        <Setter TargetName="DeleteTaskButton" Property="Opacity" Value="1"/>
                                    </Trigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>

                <!-- ===== 本周概览 + 今日已完成（折叠）===== -->
                <StackPanel Grid.Row="4" Margin="16,8,16,0">
                    <TextBlock Text="本周概览" FontSize="{DynamicResource FontSizeBody}" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}" Margin="0,0,0,7"/>
                    <Border Background="{DynamicResource CardBrush}" CornerRadius="14" Padding="10,9"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <ItemsControl ItemsSource="{Binding StatisticsViewModel.DailyStats}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="7"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel HorizontalAlignment="Center" Margin="1,0">
                                        <TextBlock Text="{Binding WeekdayChar}" FontSize="8.5"
                                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                                   HorizontalAlignment="Center"/>
                                        <Border x:Name="DayCell" Width="26" Height="26" CornerRadius="8"
                                                Margin="0,3" HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding DayNumber}" FontSize="10"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <Ellipse x:Name="DoneDot" Width="4" Height="4"
                                                 Fill="{DynamicResource SuccessBrush}" Opacity="0"
                                                 HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsToday}" Value="True">
                                            <Setter TargetName="DayCell" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                        </DataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsToday}" Value="False"/>
                                                <Condition Binding="{Binding DotState}" Value="none"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter TargetName="DayCell" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                                        </MultiDataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsToday}" Value="False"/>
                                                <Condition Binding="{Binding DotState}" Value="done"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter TargetName="DayCell" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                                        </MultiDataTrigger>
                                        <DataTrigger Binding="{Binding DotState}" Value="done">
                                            <Setter TargetName="DoneDot" Property="Opacity" Value="1"/>
                                        </DataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsToday}" Value="True"/>
                                                <Condition Binding="{Binding DotState}" Value="today"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter TargetName="DoneDot" Property="Fill" Value="White"/>
                                            <Setter TargetName="DoneDot" Property="Opacity" Value="1"/>
                                        </MultiDataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>

                    <!-- 今日已完成（可折叠）-->
                    <Border x:Name="CompletedHeader"
                            Background="{DynamicResource SurfaceHoverBrush}"
                            CornerRadius="10" Padding="10,7" Margin="0,10,0,0"
                            Cursor="Hand"
                            MouseLeftButtonDown="CompletedHeader_Click">
                        <StackPanel Orientation="Horizontal">
                            <controls:AppIcon x:Name="CompletedChevron" Glyph="{x:Static controls:Icons.ChevronDown}"
                                              FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}"
                                              VerticalAlignment="Center" Margin="0,0,7,0"/>
                            <TextBlock Text="今日已完成" FontSize="11.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                            <Border Background="{DynamicResource SuccessSoftBrush}" CornerRadius="999" Padding="7,2" Margin="7,0,0,0">
                                <TextBlock Text="{Binding TodayCompletedTasksCount}" FontSize="9.5" FontWeight="Bold"
                                           Foreground="{DynamicResource SuccessBrush}"/>
                            </Border>
                        </StackPanel>
                    </Border>
                    <ListBox x:Name="CompletedList"
                             ItemsSource="{Binding TodayCompletedTasks}"
                             Style="{StaticResource GlassListBox}"
                             MaxHeight="132"
                             Margin="2,4,2,0"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             Visibility="Collapsed">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                    <controls:AppIcon Glyph="{x:Static controls:Icons.CheckMark}"
                                                      Foreground="{DynamicResource SuccessBrush}"
                                                      FontSize="10"
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,6,0"/>
                                    <TextBlock Text="{Binding Title}"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               FontSize="11.5"
                                               TextDecorations="Strikethrough"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>

                <!-- ===== 底部 Dock：迷你番茄 + 功能图标 ===== -->
                <Border Grid.Row="5" Margin="16,10,16,14"
                        Background="{DynamicResource CardBrush}"
                        CornerRadius="16" Padding="12,9"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- 迷你番茄胶囊 -->
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="38" Height="38" VerticalAlignment="Center">
                                <controls:CircularProgress x:Name="MiniFocusRing" Size="38" StrokeThickness="4.5"
                                                           Progress="0"
                                                           ProgressBrush="{DynamicResource AccentGradientBrush}"
                                                           BackgroundBrush="{DynamicResource SurfacePressedBrush}"/>
                                <controls:AppIcon Glyph="{x:Static controls:Icons.Timer}" FontSize="12"
                                                  Foreground="{DynamicResource AccentBrush}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                            <StackPanel VerticalAlignment="Center" Margin="8,0,0,0">
                                <TextBlock x:Name="MiniFocusTimer" Text="25:00"
                                           FontSize="13.5" FontWeight="Bold"
                                           Foreground="{DynamicResource TextBrush}"/>
                                <TextBlock x:Name="MiniFocusState" Text="未开始"
                                           FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>
                            <Button Style="{StaticResource PrimaryButton}" Click="MiniFocusStart_Click"
                                    ToolTip="开始专注" Margin="10,0,0,0" VerticalAlignment="Center"
                                    Width="30" Height="30" Padding="0">
                                <controls:AppIcon Glyph="{x:Static controls:Icons.Play}" FontSize="10" Foreground="White"/>
                            </Button>
                            <Button Style="{StaticResource MiniPomoButton}" Click="MiniFocusPause_Click"
                                    ToolTip="暂停/继续" Margin="2,0,0,0" VerticalAlignment="Center">
                                <controls:AppIcon Glyph="{x:Static controls:Icons.Pause}" FontSize="8"/>
                            </Button>
                        </StackPanel>

                        <!-- 右侧功能图标组 -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource DockIconButton}" Click="StatisticsButton_Click" ToolTip="统计">
                                <controls:AppIcon Glyph="{x:Static controls:Icons.Chart}" FontSize="12"/>
                            </Button>
                            <Button Style="{StaticResource DockIconButton}" Click="ExpandFullMode_Click" ToolTip="展开完整窗口" Margin="2,0,0,0">
                                <controls:AppIcon Glyph="{x:Static controls:Icons.OpenInNewWindow}" FontSize="11"/>
                            </Button>
                            <Button Style="{StaticResource DockIconButton}"
                                    Command="{Binding SyncViewModel.UploadCommand}" ToolTip="上传到云端" Margin="2,0,0,0">
                                <controls:AppIcon Glyph="{x:Static controls:Icons.Upload}" FontSize="12"/>
                            </Button>
                            <Button Style="{StaticResource DockIconButton}" Click="LogoutButton_Click" ToolTip="退出登录" Margin="2,0,0,0">
                                <controls:AppIcon Glyph="{x:Static controls:Icons.SignOut}" FontSize="12"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- 触发条（鼠标悬停时显示主面板） -->
        <Border x:Name="TriggerStrip"
                Width="3"
                HorizontalAlignment="Left"
                Cursor="Hand">
            <Border.Background>
                <DynamicResource ResourceKey="AccentBrush"/>
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect BlurRadius="5" ShadowDepth="1" Opacity="0.3"/>
            </Border.Effect>
        </Border>

        <!-- 升级粒子层 -->
        <Canvas x:Name="ParticleLayer"
                IsHitTestVisible="False"
                Panel.ZIndex="100"/>

        <!-- 升级横幅 -->
        <Border x:Name="LevelUpBanner"
                Panel.ZIndex="101"
                Visibility="Collapsed"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,90,0,0"
                Background="{DynamicResource CardBrush}"
                BorderBrush="{DynamicResource AccentBrush}"
                BorderThickness="1.5"
                CornerRadius="14"
                Padding="20,13"
                IsHitTestVisible="False">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.45"/>
            </Border.Effect>
            <StackPanel>
                <TextBlock x:Name="LevelUpTitleText"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextBrush}"
                           HorizontalAlignment="Center"/>
                <TextBlock x:Name="LevelUpSubText"
                           FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,4,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
