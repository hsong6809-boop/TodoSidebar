<Window x:Class="TodoSidebar.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:TodoSidebar.ViewModels"
        xmlns:controls="clr-namespace:TodoSidebar.Controls"
        Title="Todo Sidebar"
        Width="320"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        Left="0"
        Top="0"
        Height="800"
        Loaded="Window_Loaded">

    <Window.Resources>
        <!-- 侧边栏按钮样式 -->
        <Style x:Key="SidebarButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid>
        <!-- 主面板 -->
        <Border x:Name="MainPanel"
                Background="{DynamicResource GlassBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,1,0"
                CornerRadius="0,16,16,0"
                Margin="0"
                Width="320">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" ShadowDepth="3" Opacity="0.15"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 顶部栏（可拖动） -->
                <Border Grid.Row="0"
                        Background="{DynamicResource GlassLightBrush}"
                        Padding="16,14"
                        CornerRadius="0,16,0,0"
                        BorderThickness="0,0,0,1"
                        BorderBrush="{DynamicResource BorderBrush}"
                        Cursor="SizeAll"
                        MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <Border Background="{DynamicResource AccentBrush}"
                                    CornerRadius="8"
                                    Width="32"
                                    Height="32"
                                    Margin="0,0,10,0">
                                <controls:AppIcon Glyph="{x:Static controls:Icons.CheckMark}"
                                                  Foreground="White"
                                                  FontSize="14"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="DateTimeText"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0,0,0,2"/>
                                <TextBlock Text="当前任务"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextBrush}"
                                           Margin="0,0,0,2"/>
                                <TextBlock FontSize="11"
                                           Foreground="{DynamicResource TextSecondaryBrush}">
                                    <Run Text="共 "/>
                                    <Run Text="{Binding CurrentTasksCount, Mode=OneWay}" FontWeight="SemiBold"/>
                                    <Run Text=" 项待办"/>
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Style="{StaticResource IconButton}"
                                    Click="SearchButton_Click"
                                    ToolTip="搜索"
                                    Width="28"
                                    Height="28">
                                <controls:AppIcon Glyph="{x:Static controls:Icons.Search}" FontSize="13"/>
                            </Button>
                            <Button Style="{StaticResource IconButton}"
                                    Click="SettingsButton_Click"
                                    ToolTip="设置"
                                    Margin="4,0,0,0">
                                <controls:AppIcon Glyph="{x:Static controls:Icons.Settings}" FontSize="13"/>
                            </Button>
                            <Button Style="{StaticResource IconButton}"
                                    Click="LogoutButton_Click"
                                    ToolTip="退出登录"
                                    Margin="4,0,0,0">
                                <controls:AppIcon Glyph="{x:Static controls:Icons.SignOut}" FontSize="13"/>
                            </Button>
                            <Button Style="{StaticResource IconButton}"
                                    Click="ExpandFullMode_Click"
                                    ToolTip="展开主窗口"
                                    Margin="4,0,0,0">
                                <controls:AppIcon Glyph="{x:Static controls:Icons.OpenInNewWindow}" FontSize="12"/>
                            </Button>
                            <Button Style="{StaticResource IconButton}"
                                    Click="CollapseButton_Click"
                                    ToolTip="收起"
                                    Margin="4,0,0,0">
                                <controls:AppIcon Glyph="{x:Static controls:Icons.ChevronLeft}" FontSize="11"/>
                            </Button>
                        </StackPanel>

                        <!-- 升级等级条 -->
                        <Border Grid.Row="1"
                                Margin="0,10,0,0"
                                Background="{DynamicResource CardBrush}"
                                CornerRadius="8"
                                Padding="10,8">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding LevelDisplay}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextBrush}"/>
                                        <TextBlock Text="{Binding ComboDisplay}"
                                                   FontSize="10"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource ComboBrush}"
                                                   VerticalAlignment="Center"
                                                   Margin="6,0,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding LevelProgressText}"
                                                   FontSize="10"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center"/>
                                        <Button Width="24"
                                                Height="24"
                                                Click="BrowseBadges_Click"
                                                ToolTip="成就图鉴"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Cursor="Hand"
                                                Margin="6,0,0,0">
                                            <controls:AppIcon Glyph="{x:Static controls:Icons.FavoriteStar}"
                                                              FontSize="12"
                                                              Foreground="{DynamicResource WarningBrush}"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                                <ProgressBar Margin="0,6,0,0"
                                             Height="6"
                                             Minimum="0"
                                             Maximum="1"
                                             Value="{Binding LevelProgress}"
                                             Foreground="{DynamicResource AccentGradientBrush}"
                                             Background="{DynamicResource SurfacePressedBrush}"
                                             BorderThickness="0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- 快速添加区域 -->
                <Border Grid.Row="1"
                        Padding="12,8"
                        BorderThickness="0,0,0,1"
                        BorderBrush="{DynamicResource BorderBrush}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Background="{DynamicResource CardBrush}"
                                    CornerRadius="8"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1">
                                <TextBox x:Name="QuickAddInput"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         Padding="10,8"
                                         FontSize="13"
                                         Foreground="{DynamicResource TextBrush}"
                                         VerticalContentAlignment="Center"
                                         KeyDown="QuickAddInput_KeyDown"/>
                            </Border>
                            <Button Grid.Column="1"
                                    Style="{StaticResource IconButton}"
                                    Click="QuickAddButton_Click"
                                    Width="32"
                                    Height="32"
                                    Margin="8,0,0,0"
                                    ToolTip="快速添加任务">
                                <controls:AppIcon Glyph="{x:Static controls:Icons.Add}" FontSize="14"/>
                            </Button>
                        </Grid>
                        <!-- 截止日期选择 -->
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <DatePicker x:Name="QuickDeadlinePicker"
                                        FontSize="11"
                                        SelectedDateFormat="Short"
                                        Height="24"
                                        VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1"
                                       Text="💡 不选日期=每日任务"
                                       FontSize="10"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       VerticalAlignment="Center"
                                       Margin="8,0,0,0"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 搜索框 -->
                <Border Grid.Row="2"
                        Padding="8,4"
                        Visibility="{Binding IsSearchMode, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Background="{DynamicResource CardBrush}"
                                CornerRadius="8"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1">
                            <TextBox x:Name="SearchInput"
                                     Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     Padding="10,8"
                                     FontSize="13"
                                     Foreground="{DynamicResource TextBrush}"
                                     VerticalContentAlignment="Center"
                                     KeyDown="SearchInput_KeyDown"/>
                        </Border>
                        <Button Grid.Column="1"
                                Style="{StaticResource IconButton}"
                                Command="{Binding ClearSearchCommand}"
                                Width="28"
                                Height="28"
                                Margin="4,0,0,0"
                                ToolTip="清除搜索">
                            <controls:AppIcon Glyph="{x:Static controls:Icons.ChromeClose}" FontSize="11"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- 搜索结果列表 -->
                <ListBox Grid.Row="3"
                         x:Name="SearchResultsListBox"
                         ItemsSource="{Binding SearchResults}"
                         Style="{StaticResource GlassListBox}"
                         Margin="8,8"
                         Visibility="{Binding IsSearchMode, Converter={StaticResource BoolToVis}}"
                         MouseDoubleClick="TaskListBox_MouseDoubleClick">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource CardBrush}"
                                    CornerRadius="10"
                                    Padding="12,10"
                                    Margin="0,2"
                                    BorderThickness="0,0,3,0"
                                    BorderBrush="{Binding TypeColor}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0"
                                            Background="{Binding PriorityColor}"
                                            CornerRadius="4"
                                            Width="4"
                                            Height="24"
                                            Margin="0,0,10,0"
                                            VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}"
                                                   Foreground="{DynamicResource TextBrush}"
                                                   FontSize="13"
                                                   FontWeight="Medium"/>
                                        <TextBlock Text="{Binding TypeText}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   FontSize="11"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- 当前任务列表 -->
                <ListBox Grid.Row="3"
                         x:Name="TaskListBox"
                         ItemsSource="{Binding CurrentTasks}"
                         Style="{StaticResource GlassListBox}"
                         Margin="8,8"
                         AllowDrop="True"
                         Drop="TaskListBox_Drop"
                         DragOver="TaskListBox_DragOver"
                         PreviewMouseLeftButtonDown="TaskListBox_PreviewMouseLeftButtonDown"
                         PreviewMouseMove="TaskListBox_PreviewMouseMove"
                         Visibility="{Binding IsSearchMode, Converter={StaticResource InvertedBoolToVis}}"
                         MouseDoubleClick="TaskListBox_MouseDoubleClick">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="TaskCard"
                                    CornerRadius="10"
                                    Padding="10,9"
                                    Margin="0,3"
                                    Cursor="Hand"
                                    MouseLeftButtonDown="TaskCard_Click">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
                                        <Setter Property="BorderThickness" Value="0,0,0,0"/>
                                        <Style.Triggers>
                                            <!-- 项目制任务：右侧警示轨 + 暖底 -->
                                            <DataTrigger Binding="{Binding Type}" Value="1">
                                                <Setter Property="Background" Value="{DynamicResource DeadlineCardBrush}"/>
                                                <Setter Property="BorderThickness" Value="0,0,3,0"/>
                                                <Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}"/>
                                            </DataTrigger>
                                            <!-- 悬停微亮（放在最后以覆盖类型底色） -->
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- 完成圆钮：单击即完成（替代常驻 ✓ 按钮） -->
                                    <Button Grid.Column="0"
                                            Width="20"
                                            Height="20"
                                            VerticalAlignment="Center"
                                            Margin="0,0,9,0"
                                            FocusVisualStyle="{x:Null}"
                                            Command="{Binding DataContext.CompleteTaskCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="完成任务">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Grid Background="Transparent">
                                                    <Ellipse x:Name="CompleteRing"
                                                             Stroke="{DynamicResource BorderStrongBrush}"
                                                             StrokeThickness="1.5"/>
                                                    <controls:AppIcon x:Name="CompleteCheck"
                                                                      Glyph="{x:Static controls:Icons.CheckMark}"
                                                                      FontSize="10"
                                                                      Foreground="{DynamicResource SuccessBrush}"
                                                                      Visibility="Hidden"
                                                                      HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"/>
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="CompleteRing" Property="Stroke" Value="{DynamicResource SuccessBrush}"/>
                                                        <Setter TargetName="CompleteRing" Property="Fill" Value="{DynamicResource SuccessSoftBrush}"/>
                                                        <Setter TargetName="CompleteCheck" Property="Visibility" Value="Visible"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>

                                    <!-- 任务内容 -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}"
                                                   Foreground="{DynamicResource TextBrush}"
                                                   FontSize="13"
                                                   FontWeight="Medium"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <!-- 项目制任务显示截止日期和倒计时（软底胶囊） -->
                                        <StackPanel x:Name="DeadlineRow"
                                                    Orientation="Horizontal"
                                                    Margin="0,4,0,0"
                                                    Visibility="Collapsed">
                                            <Border Background="{DynamicResource WarningSoftBrush}"
                                                    CornerRadius="999"
                                                    Padding="7,2"
                                                    HorizontalAlignment="Left">
                                                <StackPanel Orientation="Horizontal">
                                                    <controls:AppIcon Glyph="{x:Static controls:Icons.Recent}"
                                                                      FontSize="8"
                                                                      Foreground="{DynamicResource WarningBrush}"
                                                                      VerticalAlignment="Center"
                                                                      Margin="0,0,4,0"/>
                                                    <TextBlock Text="{Binding Deadline, StringFormat='{}{0:MM/dd}'}"
                                                               Foreground="{DynamicResource WarningBrush}"
                                                               FontSize="9.5"
                                                               FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding DeadlineUrgency}"
                                                               Foreground="{DynamicResource WarningBrush}"
                                                               FontSize="9.5"
                                                               Margin="4,0,0,0"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                        <!-- 每日任务显示标签（软底胶囊） -->
                                        <StackPanel x:Name="DailyRow"
                                                    Orientation="Horizontal"
                                                    Margin="0,4,0,0">
                                            <Border Background="{DynamicResource AccentSoftBrush}"
                                                    CornerRadius="999"
                                                    Padding="7,2"
                                                    HorizontalAlignment="Left">
                                                <TextBlock Text="每日"
                                                           FontSize="9"
                                                           Foreground="{DynamicResource AccentBrush}"
                                                           FontWeight="SemiBold"/>
                                            </Border>
                                        </StackPanel>
                                        <!-- 子任务进度（点击可展开） -->
                                        <StackPanel x:Name="SubTaskRow"
                                                    Orientation="Horizontal"
                                                    Margin="0,4,0,0"
                                                    Visibility="Collapsed">
                                            <Border Background="{DynamicResource SurfacePressedBrush}"
                                                    CornerRadius="999"
                                                    Padding="7,2"
                                                    HorizontalAlignment="Left">
                                                <StackPanel Orientation="Horizontal">
                                                    <controls:AppIcon Glyph="{x:Static controls:Icons.CheckList}"
                                                                      FontSize="8"
                                                                      Foreground="{DynamicResource AccentBrush}"
                                                                      VerticalAlignment="Center"
                                                                      Margin="0,0,4,0"/>
                                                    <TextBlock Text="{Binding SubTasksProgressText}"
                                                               FontSize="9.5"
                                                               Foreground="{DynamicResource AccentBrush}"
                                                               FontWeight="SemiBold"/>
                                                </StackPanel>
                                            </Border>
                                            <TextBlock Text="点击展开"
                                                       FontSize="9"
                                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                                       VerticalAlignment="Center"
                                                       Margin="5,0,0,0"/>
                                        </StackPanel>
                                        <!-- 展开区域：子任务详情 -->
                                        <StackPanel x:Name="ExpandArea"
                                                    Visibility="Collapsed"
                                                    Margin="0,8,0,0">
                                            <!-- 子任务列表 -->
                                            <ItemsControl x:Name="SubTasksList"
                                                          ItemsSource="{Binding SubTasksList}"
                                                          Margin="0,0,0,6">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal" Margin="0,2">
                                                            <CheckBox IsChecked="{Binding IsCompleted}"
                                                                      Click="SubTaskCheckBox_Click"
                                                                      Width="16" Height="16"
                                                                      Margin="0,0,6,0"/>
                                                            <TextBlock Text="{Binding Title}"
                                                                       FontSize="11"
                                                                       Foreground="{Binding IsCompleted, Converter={StaticResource SubTaskForeground}}"
                                                                       TextDecorations="{Binding IsCompleted, Converter={StaticResource SubTaskStrike}}"
                                                                       VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <!-- 添加子任务输入框 -->
                                            <Grid Margin="0,2,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Background="{DynamicResource SurfaceHoverBrush}"
                                                        CornerRadius="6"
                                                        BorderBrush="{DynamicResource BorderBrush}"
                                                        BorderThickness="1">
                                                    <TextBox x:Name="SubTaskInput"
                                                             Text="{Binding DataContext.NewSubTaskTitle, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=PropertyChanged}"
                                                             BorderThickness="0"
                                                             Background="Transparent"
                                                             Padding="8,4"
                                                             FontSize="11"
                                                             Foreground="{DynamicResource TextBrush}"
                                                             VerticalContentAlignment="Center"
                                                             Tag="{Binding}"
                                                             KeyDown="SubTaskInput_KeyDown"/>
                                                </Border>
                                                <Button Grid.Column="1"
                                                        Style="{StaticResource IconButton}"
                                                        Command="{Binding DataContext.AddSubTaskCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        Width="24"
                                                        Height="24"
                                                        Margin="4,0,0,0"
                                                        ToolTip="添加子任务">
                                                    <controls:AppIcon Glyph="{x:Static controls:Icons.Add}" FontSize="10"/>
                                                </Button>
                                            </Grid>
                                            <!-- 展开/收起提示 -->
                                            <TextBlock Text="点击收起 ▴"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       FontSize="9"
                                                       HorizontalAlignment="Center"
                                                       Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- 删除按钮：悬停卡片时显现 -->
                                    <Button x:Name="DeleteTaskButton"
                                            Grid.Column="2"
                                            Opacity="0"
                                            Width="24"
                                            Height="24"
                                            VerticalAlignment="Center"
                                            Command="{Binding DataContext.DeleteTaskCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource IconButton}"
                                            Foreground="{DynamicResource DangerBrush}"
                                            ToolTip="删除任务">
                                        <controls:AppIcon Glyph="{x:Static controls:Icons.Delete}" FontSize="11"/>
                                    </Button>
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <!-- 项目制任务显示截止日期行 -->
                                <DataTrigger Binding="{Binding Type}" Value="1">
                                    <Setter TargetName="DeadlineRow" Property="Visibility" Value="Visible"/>
                                    <Setter TargetName="DailyRow" Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <!-- 有子任务时显示进度 -->
                                <DataTrigger Binding="{Binding HasSubTasks}" Value="True">
                                    <Setter TargetName="SubTaskRow" Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <!-- 悬停卡片时显示删除按钮 -->
                                <Trigger SourceName="TaskCard" Property="IsMouseOver" Value="True">
                                    <Setter TargetName="DeleteTaskButton" Property="Opacity" Value="1"/>
                                </Trigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- 空状态（非搜索模式且无待办时显示） -->
                <Grid Grid.Row="3"
                      Visibility="{Binding IsSearchMode, Converter={StaticResource InvertedBoolToVis}}">
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Visibility="{Binding CurrentTasksCount, Converter={StaticResource ZeroToVisInv}}">
                        <Border Width="64" Height="64"
                                CornerRadius="32"
                                Background="{DynamicResource SurfaceHoverBrush}"
                                HorizontalAlignment="Center">
                            <controls:AppIcon Glyph="{x:Static controls:Icons.CheckMark}"
                                              FontSize="26"
                                              Foreground="{DynamicResource AccentBrush}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="今天没有待办任务"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,12,0,0"/>
                        <TextBlock Text="享受此刻，或按 Ctrl+Alt+N 快速添加"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- 今日已完成任务 -->
                <Border Grid.Row="4"
                        Padding="12,8"
                        BorderThickness="0,1,0,0"
                        BorderBrush="{DynamicResource BorderBrush}"
                        Visibility="{Binding TodayCompletedTasksCount, Converter={StaticResource ZeroToVis}}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <controls:AppIcon Glyph="{x:Static controls:Icons.CheckMark}"
                                              FontSize="11"
                                              Foreground="{DynamicResource SuccessBrush}"
                                              VerticalAlignment="Center"
                                              Margin="0,0,6,0"/>
                            <TextBlock Text="今日已完成"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <Border Background="{DynamicResource SuccessBrush}"
                                    CornerRadius="8"
                                    Padding="6,2"
                                    Margin="6,0,0,0">
                                <TextBlock Text="{Binding TodayCompletedTasksCount}"
                                           Foreground="White"
                                           FontSize="10"
                                           FontWeight="Bold"/>
                            </Border>
                        </StackPanel>
                        <ListBox ItemsSource="{Binding TodayCompletedTasks}"
                                 Style="{StaticResource GlassListBox}"
                                 MaxHeight="150"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,2">
                                        <controls:AppIcon Glyph="{x:Static controls:Icons.CheckMark}"
                                                          Foreground="{DynamicResource SuccessBrush}"
                                                          FontSize="10"
                                                          VerticalAlignment="Center"
                                                          Margin="0,0,6,0"/>
                                        <TextBlock Text="{Binding Title}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   FontSize="12"
                                                   TextDecorations="Strikethrough"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>

                <!-- 迷你番茄钟 -->
                <Border Grid.Row="5"
                        Padding="12,8"
                        BorderThickness="0,1,0,0"
                        BorderBrush="{DynamicResource BorderBrush}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <controls:CircularProgress x:Name="MiniFocusRing"
                                                   Size="36"
                                                   StrokeThickness="4"
                                                   Progress="0"
                                                   ProgressBrush="{DynamicResource AccentBrush}"
                                                   BackgroundBrush="{DynamicResource BorderBrush}"
                                                   VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="MiniFocusTimer"
                                       Text="25:00"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextBrush}"/>
                            <TextBlock x:Name="MiniFocusState"
                                       Text="🍅 未开始"
                                       FontSize="10"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource IconButton}"
                                    Click="MiniFocusStart_Click"
                                    ToolTip="开始专注（25 分钟）"
                                    Width="26"
                                    Height="26">
                                <controls:AppIcon Glyph="{x:Static controls:Icons.Play}" FontSize="11"/>
                            </Button>
                            <Button Style="{StaticResource IconButton}"
                                    Click="MiniFocusPause_Click"
                                    ToolTip="暂停/继续"
                                    Width="26"
                                    Height="26"
                                    Margin="2,0,0,0">
                                <controls:AppIcon Glyph="{x:Static controls:Icons.Pause}" FontSize="11"/>
                            </Button>
                            <Button Style="{StaticResource IconButton}"
                                    Click="MiniFocusStop_Click"
                                    ToolTip="停止（中断不计经验）"
                                    Width="26"
                                    Height="26"
                                    Margin="2,0,0,0">
                                <controls:AppIcon Glyph="{x:Static controls:Icons.Stop}" FontSize="11"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 底部操作栏 -->
                <Border Grid.Row="6"
                        Background="{DynamicResource GlassLightBrush}"
                        Padding="12,10"
                        CornerRadius="0,0,16,16"
                        BorderThickness="0,1,0,0"
                        BorderBrush="{DynamicResource BorderBrush}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Style="{StaticResource SidebarButton}"
                                Click="StatisticsButton_Click"
                                HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <controls:AppIcon Glyph="{x:Static controls:Icons.Diagnostic}"
                                                  FontSize="11"
                                                  Foreground="{DynamicResource TextSecondaryBrush}"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,5,0"/>
                                <TextBlock Text="统计"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource IconButton}"
                                Command="{Binding SyncViewModel.UploadCommand}"
                                ToolTip="上传到云端"
                                Width="28"
                                Height="28"
                                Grid.Column="1">
                            <controls:AppIcon Glyph="{x:Static controls:Icons.Upload}" FontSize="12"/>
                        </Button>
                        <Button Style="{StaticResource IconButton}"
                                Command="{Binding SyncViewModel.DownloadCommand}"
                                ToolTip="从云端下载"
                                Width="28"
                                Height="28"
                                Grid.Column="2">
                            <controls:AppIcon Glyph="{x:Static controls:Icons.Download}" FontSize="12"/>
                        </Button>

                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- 触发条（鼠标悬停时显示主面板） -->
        <Border x:Name="TriggerStrip"
                Width="3"
                HorizontalAlignment="Left"
                Cursor="Hand">
            <Border.Background>
                <DynamicResource ResourceKey="AccentBrush"/>
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect BlurRadius="5" ShadowDepth="1" Opacity="0.3"/>
            </Border.Effect>
        </Border>

        <!-- 升级粒子层 -->
        <Canvas x:Name="ParticleLayer"
                IsHitTestVisible="False"
                Panel.ZIndex="100"/>

        <!-- 升级横幅 -->
        <Border x:Name="LevelUpBanner"
                Panel.ZIndex="101"
                Visibility="Collapsed"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,90,0,0"
                Background="{DynamicResource CardBrush}"
                BorderBrush="{DynamicResource AccentBrush}"
                BorderThickness="1.5"
                CornerRadius="14"
                Padding="20,13"
                IsHitTestVisible="False">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.45"/>
            </Border.Effect>
            <StackPanel>
                <TextBlock x:Name="LevelUpTitleText"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextBrush}"
                           HorizontalAlignment="Center"/>
                <TextBlock x:Name="LevelUpSubText"
                           FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,4,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
