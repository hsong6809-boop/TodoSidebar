<Window x:Class="TodoSidebar.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:TodoSidebar.Controls"
        Title="设置"
        Width="420"
        Height="540"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize">

    <Border Background="{DynamicResource GlassBrush}"
            CornerRadius="16"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.22"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ===== 标题栏 ===== -->
            <Border Grid.Row="0"
                    Background="{DynamicResource GlassLightBrush}"
                    Padding="20,14"
                    CornerRadius="16,16,0,0"
                    BorderThickness="0,0,0,1"
                    BorderBrush="{DynamicResource BorderBrush}"
                    Cursor="SizeAll"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <controls:AppIcon Glyph="{x:Static controls:Icons.Settings}"
                                          FontSize="14"
                                          Foreground="{DynamicResource AccentBrush}"
                                          VerticalAlignment="Center"
                                          Margin="0,0,8,0"/>
                        <TextBlock Text="设置"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Style="{StaticResource CloseButtonStyle}"
                            Click="CloseButton_Click"
                            ToolTip="关闭"/>
                </Grid>
            </Border>

            <!-- ===== 内容 ===== -->
            <ScrollViewer Grid.Row="1"
                          Padding="20,16"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- 账户 -->
                    <Border Background="{DynamicResource CardBrush}"
                            CornerRadius="12"
                            Padding="14,12"
                            Margin="0,0,0,12">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <controls:AppIcon Glyph="{x:Static controls:Icons.FavoriteStar}"
                                                  FontSize="12"
                                                  Foreground="{DynamicResource AccentBrush}"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,6,0"/>
                                <TextBlock Text="账户"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextBrush}"/>
                            </StackPanel>
                            <TextBlock x:Name="AccountText"
                                       Text="当前版本：Free 版"
                                       FontSize="13"
                                       Foreground="{DynamicResource TextBrush}"/>
                        </StackPanel>
                    </Border>

                    <!-- 主题 -->
                    <Border Background="{DynamicResource CardBrush}"
                            CornerRadius="12"
                            Padding="14,12"
                            Margin="0,0,0,12">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <controls:AppIcon Glyph="{x:Static controls:Icons.ColorBg}"
                                                  FontSize="12"
                                                  Foreground="{DynamicResource AccentBrush}"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,6,0"/>
                                <TextBlock Text="主题"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextBrush}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <RadioButton x:Name="ThemeLightRadio"
                                             Content="☀️ 浅色"
                                             Tag="Light"
                                             Margin="0,0,8,0"
                                             Checked="Theme_Changed"/>
                                <RadioButton x:Name="ThemeDarkRadio"
                                             Content="🌙 深色"
                                             Tag="Dark"
                                             Margin="0,0,8,0"
                                             Checked="Theme_Changed"/>
                                <RadioButton x:Name="ThemeSystemRadio"
                                             Content="💻 跟随系统"
                                             Tag="System"
                                             Checked="Theme_Changed"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 强调色 -->
                    <Border Background="{DynamicResource CardBrush}"
                            CornerRadius="12"
                            Padding="14,12"
                            Margin="0,0,0,12">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <controls:AppIcon Glyph="{x:Static controls:Icons.ColorBg}"
                                                  FontSize="12"
                                                  Foreground="{DynamicResource AccentBrush}"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,6,0"/>
                                <TextBlock Text="强调色"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextBrush}"/>
                            </StackPanel>
                            <WrapPanel x:Name="AccentSwatchPanel" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- 数据 -->
                    <Border Background="{DynamicResource CardBrush}"
                            CornerRadius="12"
                            Padding="14,12"
                            Margin="0,0,0,12">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <controls:AppIcon Glyph="{x:Static controls:Icons.Save}"
                                                  FontSize="12"
                                                  Foreground="{DynamicResource AccentBrush}"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,6,0"/>
                                <TextBlock Text="数据"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextBrush}"/>
                            </StackPanel>
                            <WrapPanel Margin="0,4,0,0">
                                <Button Content="导出 JSON"
                                        Style="{StaticResource SecondaryButton}"
                                        Padding="12,7"
                                        Margin="0,0,8,8"
                                        Click="ExportJson_Click"/>
                                <Button Content="导出 CSV"
                                        Style="{StaticResource SecondaryButton}"
                                        Padding="12,7"
                                        Margin="0,0,8,8"
                                        Click="ExportCsv_Click"/>
                                <Button Content="导入"
                                        Style="{StaticResource SecondaryButton}"
                                        Padding="12,7"
                                        Margin="0,0,8,8"
                                        Click="Import_Click"/>
                                <Button Content="备份"
                                        Style="{StaticResource SecondaryButton}"
                                        Padding="12,7"
                                        Margin="0,0,0,8"
                                        Click="Backup_Click"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- 关于 -->
                    <Border Background="{DynamicResource CardBrush}"
                            CornerRadius="12"
                            Padding="14,12">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <controls:AppIcon Glyph="{x:Static controls:Icons.Info}"
                                                  FontSize="12"
                                                  Foreground="{DynamicResource AccentBrush}"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,6,0"/>
                                <TextBlock Text="关于"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextBrush}"/>
                            </StackPanel>
                            <TextBlock x:Name="VersionText"
                                       Text="版本 4.2.2 · 每日任务"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ===== 底栏 ===== -->
            <Border Grid.Row="2"
                    Background="{DynamicResource GlassLightBrush}"
                    Padding="20,12"
                    CornerRadius="0,0,16,16"
                    BorderThickness="0,1,0,0"
                    BorderBrush="{DynamicResource BorderBrush}">
                <Button Content="关闭"
                        Style="{StaticResource SecondaryButton}"
                        Padding="28,7"
                        HorizontalAlignment="Right"
                        Click="CloseButton_Click"/>
            </Border>
        </Grid>
    </Border>
</Window>
