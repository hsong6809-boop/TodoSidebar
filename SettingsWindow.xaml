<Window x:Class="TodoSidebar.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:TodoSidebar.Controls"
        Title="设置"
        Width="420"
        Height="540"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize">

    <Border Background="{DynamicResource GlassBrush}"
            CornerRadius="16"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.22"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ===== 标题栏 ===== -->
            <Border Grid.Row="0"
                    Background="{DynamicResource GlassLightBrush}"
                    Padding="20,14"
                    CornerRadius="16,16,0,0"
                    BorderThickness="0,0,0,1"
                    BorderBrush="{DynamicResource BorderBrush}"
                    Cursor="SizeAll"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <controls:AppIcon Glyph="{x:Static controls:Icons.Settings}"
                                          FontSize="14"
                                          Foreground="{DynamicResource AccentBrush}"
                                          VerticalAlignment="Center"
                                          Margin="0,0,8,0"/>
                        <TextBlock Text="设置"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Style="{StaticResource CloseButtonStyle}"
                            Click="CloseButton_Click"
                            ToolTip="关闭"/>
                </Grid>
            </Border>

            <!-- ===== 内容 ===== -->
            <ScrollViewer Grid.Row="1"
                          Padding="20,16"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- 账户 -->
                    <Border Background="{DynamicResource CardBrush}"
                            CornerRadius="12"
                            Padding="14,12"
                            Margin="0,0,0,12">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <controls:AppIcon Glyph="{x:Static controls:Icons.FavoriteStar}"
                                                  FontSize="12"
                                                  Foreground="{DynamicResource AccentBrush}"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,6,0"/>
                                <TextBlock Text="账户"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextBrush}"/>
                            </StackPanel>
                            <TextBlock x:Name="AccountText"
                                       Text="当前版本：Free 版"
                                       FontSize="13"
                                       Foreground="{DynamicResource TextBrush}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Content="打开账号中心"
                                        Style="{StaticResource SecondaryButton}"
                                        Padding="13,5"
                                        Click="OpenAccountCenter_Click"
                                        ToolTip="管理昵称、头像与账号 ID"/>
                                <!-- v5.2 昵称/头像编辑迁移至账号中心 -->
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 主题 -->
                    <Border Background="{DynamicResource CardBrush}"
                            CornerRadius="12"
                            Padding="14,12"
                            Margin="0,0,0,12">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <controls:AppIcon Glyph="{x:Static controls:Icons.ColorBg}"
                                                  FontSize="12"
                                                  Foreground="{DynamicResource AccentBrush}"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,6,0"/>
                                <TextBlock Text="主题"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextBrush}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <RadioButton x:Name="ThemeLightRadio"
                                             Content="☀️ 浅色"
                                             Tag="Light"
                                             Margin="0,0,8,0"
                                             Checked="Theme_Changed"/>
                                <RadioButton x:Name="ThemeDarkRadio"
                                             Content="🌙 深色"
                                             Tag="Dark"
                                             Margin="0,0,8,0"
                                             Checked="Theme_Changed"/>
                                <RadioButton x:Name="ThemeSystemRadio"
                                             Content="💻 跟随系统"
                                             Tag="System"
                                             Checked="Theme_Changed"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 显示形态（v5.7 悬浮球） -->
                    <Border Background="{DynamicResource CardBrush}"
                            CornerRadius="12"
                            Padding="14,12"
                            Margin="0,0,0,12">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <controls:AppIcon Glyph="{x:Static controls:Icons.Orb}"
                                                  FontSize="12"
                                                  Foreground="{DynamicResource AccentBrush}"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,6,0"/>
                                <TextBlock Text="显示形态"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextBrush}"/>
                            </StackPanel>
                            <TextBlock Text="启动形态" FontSize="11.5"
                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,4"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <RadioButton x:Name="StartupSidebarRadio" Content="📒 侧边栏" Tag="sidebar" Margin="0,0,8,0" Checked="StartupMode_Changed"/>
                                <RadioButton x:Name="StartupFullRadio" Content="🪟 完整窗口" Tag="full" Margin="0,0,8,0" Checked="StartupMode_Changed"/>
                                <RadioButton x:Name="StartupWidgetRadio" Content="⚪ 悬浮球" Tag="widget" Checked="StartupMode_Changed"/>
                            </StackPanel>
                            <TextBlock Text="悬浮球形状" FontSize="11.5"
                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,4"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <RadioButton x:Name="WidgetPillRadio" Content="💊 条形胶囊" Tag="pill" Margin="0,0,8,0" Checked="WidgetShape_Changed"/>
                                <RadioButton x:Name="WidgetCircleRadio" Content="⭕ 圆形" Tag="circle" Checked="WidgetShape_Changed"/>
                            </StackPanel>
                            <TextBlock Text="轮换信息（悬浮球上每轮循环显示）" FontSize="11.5"
                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,4"/>
                            <WrapPanel Margin="0,0,0,6">
                                <CheckBox x:Name="WidgetItemNext" Content="接下来" FontSize="12.5" Margin="0,0,10,4" Checked="WidgetItem_Changed" Unchecked="WidgetItem_Changed"/>
                                <CheckBox x:Name="WidgetItemToday" Content="今日进度" FontSize="12.5" Margin="0,0,10,4" Checked="WidgetItem_Changed" Unchecked="WidgetItem_Changed"/>
                                <CheckBox x:Name="WidgetItemTyping" Content="输入字数" FontSize="12.5" Margin="0,0,10,4" Checked="WidgetItem_Changed" Unchecked="WidgetItem_Changed"/>
                                <CheckBox x:Name="WidgetItemCombo" Content="连击" FontSize="12.5" Margin="0,0,0,4" Checked="WidgetItem_Changed" Unchecked="WidgetItem_Changed"/>
                            </WrapPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                <TextBlock Text="轮换间隔" FontSize="11.5"
                                           Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                <Slider x:Name="WidgetIntervalSlider" Width="150" Minimum="3" Maximum="30"
                                        IsSnapToTickEnabled="True" TickFrequency="1"
                                        Margin="10,0,8,0" VerticalAlignment="Center"
                                        ValueChanged="WidgetInterval_Changed"/>
                                <TextBlock x:Name="WidgetIntervalText" Text="6 秒" FontSize="11.5"
                                           Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" Width="34"/>
                            </StackPanel>
                            <CheckBox x:Name="WidgetIdleFadeCheck" Content="闲置 20 秒后自动淡化（不挡视线）" FontSize="12.5" Margin="0,4,0,0"
                                      Checked="WidgetIdleFade_Changed" Unchecked="WidgetIdleFade_Changed"/>
                            <CheckBox x:Name="WidgetLockCheck" Content="锁定位置（拖动）" FontSize="12.5" Margin="0,4,0,0"
                                      Checked="WidgetLock_Changed" Unchecked="WidgetLock_Changed"/>
                            <TextBlock Text="提示：单击悬浮球手动翻页，双击展开完整窗口，拖动可移动位置，右键有快捷菜单。"
                                       FontSize="11" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- 强调色 -->
                    <Border Background="{DynamicResource CardBrush}"
                            CornerRadius="12"
                            Padding="14,12"
                            Margin="0,0,0,12">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <controls:AppIcon Glyph="{x:Static controls:Icons.ColorBg}"
                                                  FontSize="12"
                                                  Foreground="{DynamicResource AccentBrush}"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,6,0"/>
                                <TextBlock Text="强调色"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextBrush}"/>
                            </StackPanel>
                            <WrapPanel x:Name="AccentSwatchPanel" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- 动效 -->
                    <Border Background="{DynamicResource CardBrush}"
                            CornerRadius="12"
                            Padding="14,12"
                            Margin="0,0,0,12">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <controls:AppIcon Glyph="{x:Static controls:Icons.PlayCircle}"
                                                  FontSize="12"
                                                  Foreground="{DynamicResource AccentBrush}"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,6,0"/>
                                <TextBlock Text="动效"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextBrush}"/>
                            </StackPanel>
                            <CheckBox x:Name="ReduceMotionCheck"
                                      Content="减少动态效果（关闭列表入场与页面转场动画）"
                                      FontSize="12.5"
                                      Checked="ReduceMotion_Changed"
                                      Unchecked="ReduceMotion_Changed"/>
                        </StackPanel>
                    </Border>

                    <!-- 输入统计（R61，默认关闭） -->
                    <Border Background="{DynamicResource CardBrush}"
                            CornerRadius="12"
                            Padding="14,12"
                            Margin="0,0,0,12">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <controls:AppIcon Glyph="{x:Static controls:Icons.Trending}"
                                                  FontSize="12"
                                                  Foreground="{DynamicResource AccentBrush}"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,6,0"/>
                                <TextBlock Text="输入统计"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextBrush}"/>
                            </StackPanel>
                            <CheckBox x:Name="TypingStatsCheck"
                                      Content="记录我的每日打字量（击键数 + Word 口径估算字数）"
                                      FontSize="12.5"
                                      Checked="TypingStats_Changed"
                                      Unchecked="TypingStats_Changed"/>
                            <TextBlock Text="只统计数量、不存储任何按键或文本内容；数据仅保存在本机。中文按拼音音节估算，存在 ±15% 内偏差。"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- 数据 -->
                    <Border Background="{DynamicResource CardBrush}"
                            CornerRadius="12"
                            Padding="14,12"
                            Margin="0,0,0,12">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <controls:AppIcon Glyph="{x:Static controls:Icons.Save}"
                                                  FontSize="12"
                                                  Foreground="{DynamicResource AccentBrush}"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,6,0"/>
                                <TextBlock Text="数据"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextBrush}"/>
                            </StackPanel>
                            <WrapPanel Margin="0,4,0,0">
                                <Button Content="导出 JSON"
                                        Style="{StaticResource SecondaryButton}"
                                        Padding="12,7"
                                        Margin="0,0,8,8"
                                        Click="ExportJson_Click"/>
                                <Button Content="导出 CSV"
                                        Style="{StaticResource SecondaryButton}"
                                        Padding="12,7"
                                        Margin="0,0,8,8"
                                        Click="ExportCsv_Click"/>
                                <Button Content="导出 Markdown"
                                        Style="{StaticResource SecondaryButton}"
                                        Padding="12,7"
                                        Margin="0,0,8,8"
                                        Click="ExportMarkdown_Click"/>
                                <Button Content="导入"
                                        Style="{StaticResource SecondaryButton}"
                                        Padding="12,7"
                                        Margin="0,0,8,8"
                                        Click="Import_Click"/>
                                <Button Content="备份"
                                        Style="{StaticResource SecondaryButton}"
                                        Padding="12,7"
                                        Margin="0,0,0,8"
                                        Click="Backup_Click"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- 关于 -->
                    <Border Background="{DynamicResource CardBrush}"
                            CornerRadius="12"
                            Padding="14,12">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <controls:AppIcon Glyph="{x:Static controls:Icons.Info}"
                                                  FontSize="12"
                                                  Foreground="{DynamicResource AccentBrush}"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,6,0"/>
                                <TextBlock Text="关于"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextBrush}"/>
                            </StackPanel>
                            <TextBlock x:Name="VersionText"
                                       Text="版本 4.2.2 · 每日任务"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>

                            <!-- M40：检查更新 -->
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button x:Name="UpdateCheckButton"
                                        Content="检查更新"
                                        Style="{StaticResource SecondaryButton}"
                                        Padding="16,5"
                                        Click="CheckUpdate_Click"/>
                                <TextBlock x:Name="UpdateStatusText"
                                           Text=""
                                           FontSize="12"
                                           VerticalAlignment="Center"
                                           Margin="10,0,0,0"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ===== 底栏 ===== -->
            <Border Grid.Row="2"
                    Background="{DynamicResource GlassLightBrush}"
                    Padding="20,12"
                    CornerRadius="0,0,16,16"
                    BorderThickness="0,1,0,0"
                    BorderBrush="{DynamicResource BorderBrush}">
                <Button Content="关闭"
                        Style="{StaticResource SecondaryButton}"
                        Padding="28,7"
                        HorizontalAlignment="Right"
                        Click="CloseButton_Click"/>
            </Border>
        </Grid>
    </Border>
</Window>
