<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:converters="clr-namespace:TodoSidebar.Converters"
                    xmlns:controls="clr-namespace:TodoSidebar.Controls">
    <!--
        ============================================================
        数据模板库（Styles.Templates）
        从 App.xaml 迁入；P3 阶段将在此重设计任务卡。
        ============================================================
    -->

    <!-- ========== 转换器（从 App.xaml 迁入，供模板与窗口使用）========== -->
    <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    <converters:InvertedBoolToVisibilityConverter x:Key="InvertedBoolToVis"/>
    <converters:NullToVisibilityConverter x:Key="NullToVis"/>
    <converters:ZeroToVisibilityConverter x:Key="ZeroToVis"/>
    <converters:SubTaskCompletionToStrikethrough x:Key="SubTaskStrike"/>
    <converters:SubTaskCompletionToForeground x:Key="SubTaskForeground"/>
    <converters:SubTaskProgressToWidth x:Key="SubTaskProgressWidth"/>
    <converters:ZeroToInvertedVisibilityConverter x:Key="ZeroToVisInv"/>
    <converters:MultiplyConverter x:Key="Multiply"/>
    <converters:FractionToPercentConverter x:Key="FractionToPercent"/>

    <!-- ========== 通用任务卡片模板 ========== -->
    <DataTemplate x:Key="TaskCardTemplate">
        <Border Background="{DynamicResource CardBrush}"
                CornerRadius="10"
                Padding="16,12"
                Margin="0,4"
                BorderThickness="0,0,4,0"
                BorderBrush="{Binding TypeColor, FallbackValue=#6366F1}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Background="{Binding PriorityColor, FallbackValue=#6366F1}"
                                CornerRadius="4"
                                Width="8"
                                Height="8"
                                Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding Title}"
                                   Foreground="{DynamicResource TextBrush}"
                                   FontSize="15"
                                   FontWeight="Medium"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="16,4,0,0">
                        <TextBlock Text="{Binding PriorityIcon, StringFormat='优先级: {0}'}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="12"/>
                        <!-- 子任务进度 -->
                        <TextBlock Text="{Binding SubTasksProgressText}"
                                   Foreground="{DynamicResource AccentBrush}"
                                   FontSize="11"
                                   Margin="8,0,0,0"
                                   FontWeight="SemiBold"
                                   Visibility="{Binding HasSubTasks, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Command="{Binding DataContext.CompleteTaskCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}"
                            Style="{DynamicResource SuccessButton}"
                            Padding="10,7"
                            Margin="4,0">
                        <controls:AppIcon Glyph="{x:Static controls:Icons.CheckMark}" FontSize="10" Foreground="White"/>
                    </Button>
                    <Button Command="{Binding DataContext.DeleteTaskCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}"
                            Style="{DynamicResource DangerButton}"
                            Padding="10,7">
                        <controls:AppIcon Glyph="{x:Static controls:Icons.ChromeClose}" FontSize="9" Foreground="White"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </DataTemplate>

    <!-- ========== 截止任务卡片模板 ========== -->
    <DataTemplate x:Key="DeadlineTaskCardTemplate">
        <Border Background="{DynamicResource CardBrush}"
                CornerRadius="10"
                Padding="16,12"
                Margin="0,4"
                BorderThickness="0,0,4,0"
                BorderBrush="{DynamicResource TypeDeadlineBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Background="{Binding PriorityColor, FallbackValue=#6366F1}"
                                CornerRadius="4"
                                Width="8"
                                Height="8"
                                Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding Title}"
                                   Foreground="{DynamicResource TextBrush}"
                                   FontSize="15"
                                   FontWeight="Medium"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="16,4,0,0">
                        <TextBlock Text="{Binding Deadline, StringFormat='截止: {0:yyyy/MM/dd}'}"
                                   Foreground="{DynamicResource WarningBrush}"
                                   FontSize="12"/>
                        <!-- 子任务进度 -->
                        <TextBlock Text="{Binding SubTasksProgressText}"
                                   Foreground="{DynamicResource AccentBrush}"
                                   FontSize="11"
                                   Margin="8,0,0,0"
                                   FontWeight="SemiBold"
                                   Visibility="{Binding HasSubTasks, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Command="{Binding DataContext.CompleteTaskCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}"
                            Style="{DynamicResource SuccessButton}"
                            Padding="10,7"
                            Margin="4,0">
                        <controls:AppIcon Glyph="{x:Static controls:Icons.CheckMark}" FontSize="10" Foreground="White"/>
                    </Button>
                    <Button Command="{Binding DataContext.DeleteTaskCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}"
                            Style="{DynamicResource DangerButton}"
                            Padding="10,7">
                        <controls:AppIcon Glyph="{x:Static controls:Icons.ChromeClose}" FontSize="9" Foreground="White"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </DataTemplate>

    <!-- ========== 历史任务卡片模板 ========== -->
    <DataTemplate x:Key="HistoryTaskCardTemplate">
        <Border Background="{DynamicResource CardBrush}"
                CornerRadius="10"
                Padding="16,12"
                Margin="0,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding Title}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextDecorations="Strikethrough"
                               FontSize="15"/>
                    <TextBlock Text="{Binding CompletedAt, StringFormat='完成于: {0:yyyy/MM/dd HH:mm}'}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="12"
                               Margin="0,4,0,0"/>
                </StackPanel>
                <Button Grid.Column="1"
                        Content="↩ 恢复"
                        Command="{Binding DataContext.RestoreHistoryTaskCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding}"
                        Style="{DynamicResource PrimaryButton}"
                        Padding="12,6"/>
            </Grid>
        </Border>
    </DataTemplate>
</ResourceDictionary>
