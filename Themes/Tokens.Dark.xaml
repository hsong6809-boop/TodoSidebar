<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        ============================================================
        设计令牌 · 深色主题（Design Tokens · Dark）
        键名必须与 Tokens.Light.xaml 完全一致。
        ============================================================
    -->

    <!-- ========== 表面色 ========== -->
    <SolidColorBrush x:Key="GlassBrush" Color="#E60F172A"/>
    <SolidColorBrush x:Key="GlassLightBrush" Color="#F01E293B"/>
    <SolidColorBrush x:Key="CardBrush" Color="#FF1E293B"/>
    <SolidColorBrush x:Key="CardHoverBrush" Color="#FF334155"/>
    <SolidColorBrush x:Key="DeadlineCardBrush" Color="#FF1A1510"/>
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#14FFFFFF"/>
    <SolidColorBrush x:Key="SurfacePressedBrush" Color="#1FFFFFFF"/>

    <!-- ========== 文本色 ========== -->
    <SolidColorBrush x:Key="TextBrush" Color="#FFF1F5F9"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#FF94A3B8"/>
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#FF64748B"/>

    <!-- ========== 描边 ========== -->
    <SolidColorBrush x:Key="BorderBrush" Color="#24FFFFFF"/>
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#FF475569"/>

    <!-- ========== 强调色（Indigo，深色下提亮一档）========== -->
    <SolidColorBrush x:Key="AccentBrush" Color="#FF818CF8"/>
    <SolidColorBrush x:Key="AccentLightBrush" Color="#FFA5B4FC"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#FFA5B4FC"/>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#FFC7D2FE"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#29818CF8"/>
    <Color x:Key="AccentGlowColor">#818CF8</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="#FF818CF8"/>
    <!-- 强调渐变（深色下提亮一档） -->
    <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF818CF8" Offset="0"/>
        <GradientStop Color="#FFA78BFA" Offset="1"/>
    </LinearGradientBrush>

    <!-- ========== 状态色（深色下提亮一档保证可读）========== -->
    <SolidColorBrush x:Key="SuccessBrush" Color="#FF34D399"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#FFF87171"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#FFFBBF24"/>
    <SolidColorBrush x:Key="SuccessSoftBrush" Color="#2934D399"/>
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#29F87171"/>
    <SolidColorBrush x:Key="WarningSoftBrush" Color="#29FBBF24"/>

    <!-- ========== 优先级色 ========== -->
    <SolidColorBrush x:Key="PriorityHighBrush" Color="#FFF87171"/>
    <SolidColorBrush x:Key="PriorityMediumBrush" Color="#FFFBBF24"/>
    <SolidColorBrush x:Key="PriorityLowBrush" Color="#FF34D399"/>

    <!-- ========== 任务类型色 ========== -->
    <SolidColorBrush x:Key="TypeDailyBrush" Color="#FF818CF8"/>
    <SolidColorBrush x:Key="TypeDeadlineBrush" Color="#FFF87171"/>

    <!-- ========== 连击/游戏化强调 ========== -->
    <SolidColorBrush x:Key="ComboBrush" Color="#FFFB923C"/>
</ResourceDictionary>
