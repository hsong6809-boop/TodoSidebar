<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        ============================================================
        设计令牌 · 浅色主题（Design Tokens · Light）
        由 ThemeManager 整本替换实现换肤；键名必须与 Tokens.Dark.xaml 完全一致。
        ============================================================
    -->

    <!-- ========== 表面色 ========== -->
    <!-- 窗体毛玻璃底（无 DWM 背板时的回退） -->
    <SolidColorBrush x:Key="GlassBrush" Color="#CCF8F9FE"/>
    <!-- 头部/底栏浅表面 -->
    <SolidColorBrush x:Key="GlassLightBrush" Color="#E6F0F2F8"/>
    <!-- 卡片 -->
    <SolidColorBrush x:Key="CardBrush" Color="#F5FFFFFF"/>
    <SolidColorBrush x:Key="CardHoverBrush" Color="#FFFAFBFF"/>
    <!-- 截止任务卡暖底 -->
    <SolidColorBrush x:Key="DeadlineCardBrush" Color="#FFFBF5F0"/>
    <!-- 中性悬停 / 按压 tint（替代旧黑色半透明遮罩，双主题通用） -->
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#0F0F172A"/>
    <SolidColorBrush x:Key="SurfacePressedBrush" Color="#1A0F172A"/>

    <!-- ========== 文本色 ========== -->
    <SolidColorBrush x:Key="TextBrush" Color="#0F172A"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#64748B"/>
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#94A3B8"/>

    <!-- ========== 描边 ========== -->
    <SolidColorBrush x:Key="BorderBrush" Color="#1F0F172A"/>
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#FFCBD5E1"/>

    <!-- ========== 强调色（Indigo）========== -->
    <SolidColorBrush x:Key="AccentBrush" Color="#FF6366F1"/>
    <SolidColorBrush x:Key="AccentLightBrush" Color="#FF818CF8"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#FF4F46E5"/>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#FF4338CA"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#1F6366F1"/>
    <!-- 焦点光晕颜色（供 DropShadowEffect.Color 使用） -->
    <Color x:Key="AccentGlowColor">#6366F1</Color>

    <!-- 主色调别名（历史兼容，与 Accent 同值） -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="#FF6366F1"/>
    <!-- 强调渐变（XP 条 / 专注环等进度视觉） -->
    <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF6366F1" Offset="0"/>
        <GradientStop Color="#FF8B5CF6" Offset="1"/>
    </LinearGradientBrush>

    <!-- ========== 状态色 ========== -->
    <SolidColorBrush x:Key="SuccessBrush" Color="#FF10B981"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#FFEF4444"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#FFF59E0B"/>
    <SolidColorBrush x:Key="SuccessSoftBrush" Color="#1F10B981"/>
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#1FEF4444"/>
    <SolidColorBrush x:Key="WarningSoftBrush" Color="#1FF59E0B"/>

    <!-- ========== 优先级色 ========== -->
    <SolidColorBrush x:Key="PriorityHighBrush" Color="#FFEF4444"/>
    <SolidColorBrush x:Key="PriorityMediumBrush" Color="#FFF59E0B"/>
    <SolidColorBrush x:Key="PriorityLowBrush" Color="#FF10B981"/>

    <!-- ========== 任务类型色 ========== -->
    <SolidColorBrush x:Key="TypeDailyBrush" Color="#FF6366F1"/>
    <SolidColorBrush x:Key="TypeDeadlineBrush" Color="#FFEF4444"/>

    <!-- ========== 连击/游戏化强调 ========== -->
    <SolidColorBrush x:Key="ComboBrush" Color="#FFEA580C"/>
</ResourceDictionary>
