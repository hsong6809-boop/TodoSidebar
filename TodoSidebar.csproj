<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>TodoSidebar</RootNamespace>
    <AssemblyName>TodoSidebar</AssemblyName>
    <Nullable>enable</Nullable>
    <Version>5.3.1</Version>
    <AssemblyTitle>TodoSidebar</AssemblyTitle>
    <Description>Todo 任务管理侧边栏</Description>
    <Company>TodoSidebar</Company>
    <Product>TodoSidebar</Product>
    <ApplicationIcon>todo.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
    <PackageReference Include="CommunityToolkit.WinUI.Notifications" Version="7.1.2" />
    <PackageReference Include="Supabase" Version="1.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
  </ItemGroup>

  <!-- v5.6 白噪音音频资源 -->
  <ItemGroup>
    <Resource Include="Assets\Audio\*.wav" Condition="Exists('Assets\Audio')" />
  </ItemGroup>

  <!-- 排除测试项目目录与工具探针，防止误编译 -->
  <PropertyGroup>
    <DefaultItemExcludes>$(DefaultItemExcludes);TodoSidebar.Tests\**;tools\**</DefaultItemExcludes>
  </PropertyGroup>

  <!-- v5.2：允许测试工程访问 internal 纯逻辑函数 -->
  <ItemGroup>
    <InternalsVisibleTo Include="TodoSidebar.Tests" />
  </ItemGroup>

</Project>
