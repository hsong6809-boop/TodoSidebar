<Window x:Class="TodoSidebar.WidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:TodoSidebar.Controls"
        Title="Todo Widget"
        Width="212"
        Height="64"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowActivated="False"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        ResizeMode="NoResize"
        SourceInitialized="Window_SourceInitialized"
        Loaded="Window_Loaded"
        Closed="Window_Closed">

    <!-- 悬浮球右键菜单（窗口级，两种形态共用） -->
    <Window.ContextMenu>
        <ContextMenu>
            <MenuItem Header="展开完整窗口" Click="MenuFull_Click"/>
            <MenuItem Header="切回侧边栏" Click="MenuSidebar_Click"/>
            <Separator/>
            <MenuItem x:Name="MenuLock" Header="锁定位置" IsCheckable="True" Click="MenuLock_Click"/>
            <MenuItem x:Name="MenuIdleFade" Header="闲置自动淡化" IsCheckable="True" Click="MenuIdleFade_Click"/>
            <Separator/>
            <MenuItem Header="设置…" Click="MenuSettings_Click"/>
            <Separator/>
            <MenuItem Header="退出应用" Click="MenuExit_Click"/>
        </ContextMenu>
    </Window.ContextMenu>

    <Window.Resources>
        <!-- 悬停微放大 + 描边提亮（两种形态共享的样式组） -->
        <Storyboard x:Key="HoverGrow">
            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1.04" Duration="0:0:0.12"/>
            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1.04" Duration="0:0:0.12"/>
        </Storyboard>
        <Storyboard x:Key="HoverShrink">
            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1" Duration="0:0:0.16"/>
            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1" Duration="0:0:0.16"/>
        </Storyboard>
        <Style x:Key="WidgetBorderStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="Background" Value="{DynamicResource GlassBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- ===== 条形挂件形态（默认）：圆角矩形，不再是压扁的椭圆 ===== -->
        <Border x:Name="PillRoot"
                Margin="8"
                CornerRadius="15"
                Style="{StaticResource WidgetBorderStyle}"
                Cursor="Hand"
                MouseLeftButtonDown="Root_MouseLeftButtonDown"
                MouseEnter="Root_MouseEnter"
                MouseMove="Root_MouseMove">
            <Border.RenderTransform>
                <ScaleTransform/>
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.28"/>
            </Border.Effect>
            <Border.Triggers>
                <EventTrigger RoutedEvent="MouseEnter">
                    <BeginStoryboard Storyboard="{StaticResource HoverGrow}"/>
                </EventTrigger>
                <EventTrigger RoutedEvent="MouseLeave">
                    <BeginStoryboard Storyboard="{StaticResource HoverShrink}"/>
                </EventTrigger>
            </Border.Triggers>
            <Grid>
                <Grid Margin="13,6,16,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 进度环：内嵌百分比 -->
                    <Grid Width="34" Height="34" VerticalAlignment="Center">
                        <controls:CircularProgress x:Name="PillRing" Size="34" StrokeThickness="4.5"
                                                   Progress="0"
                                                   ProgressBrush="{DynamicResource AccentGradientBrush}"
                                                   BackgroundBrush="{DynamicResource SurfacePressedBrush}"/>
                        <TextBlock x:Name="PillPercentText" Text="--%"
                                   FontSize="9" FontWeight="Bold"
                                   Foreground="{DynamicResource AccentBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- 双行文字：小标签 + 主数值 -->
                    <StackPanel x:Name="PillContent" Grid.Column="1"
                                VerticalAlignment="Center" Margin="12,0,0,1">
                        <TextBlock x:Name="PillLabel" Text="接下来"
                                   FontSize="9" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="PillValue" Text="加载中…"
                                   FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}"
                                   TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- 玻璃高光描边（rim light，覆盖整个挂件） -->
                <Border CornerRadius="14" BorderBrush="#12FFFFFF" BorderThickness="1"
                        IsHitTestVisible="False"/>
            </Grid>
        </Border>

        <!-- ===== 圆形球形态 ===== -->
        <Border x:Name="CircleRoot"
                Margin="8"
                Width="64" Height="64"
                Visibility="Collapsed"
                Style="{StaticResource WidgetBorderStyle}"
                CornerRadius="999"
                Cursor="Hand"
                MouseLeftButtonDown="Root_MouseLeftButtonDown"
                MouseEnter="Root_MouseEnter"
                MouseMove="Root_MouseMove">
            <Border.RenderTransform>
                <ScaleTransform/>
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.28"/>
            </Border.Effect>
            <Border.Triggers>
                <EventTrigger RoutedEvent="MouseEnter">
                    <BeginStoryboard Storyboard="{StaticResource HoverGrow}"/>
                </EventTrigger>
                <EventTrigger RoutedEvent="MouseLeave">
                    <BeginStoryboard Storyboard="{StaticResource HoverShrink}"/>
                </EventTrigger>
            </Border.Triggers>
            <Grid>
                <controls:CircularProgress x:Name="CircleRing" Size="64" StrokeThickness="5.5"
                                           Progress="0"
                                           ProgressBrush="{DynamicResource AccentGradientBrush}"
                                           BackgroundBrush="{DynamicResource SurfacePressedBrush}"/>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock x:Name="CircleValue" Text="0 / 0"
                               FontSize="12.5" FontWeight="Bold"
                               Foreground="{DynamicResource TextBrush}"
                               HorizontalAlignment="Center"/>
                    <TextBlock x:Name="CircleLabel" Text="今日"
                               FontSize="8.5"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               HorizontalAlignment="Center" Margin="0,1,0,0"/>
                </StackPanel>
                <!-- 玻璃高光描边 -->
                <Border CornerRadius="999" BorderBrush="#12FFFFFF" BorderThickness="1"
                        IsHitTestVisible="False"/>
            </Grid>
        </Border>
    </Grid>
</Window>
