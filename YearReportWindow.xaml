<Window x:Class="TodoSidebar.YearReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:TodoSidebar.Controls"
        Title="年度报告"
        Width="430" Height="660"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent">

    <Border Background="{DynamicResource GlassBrush}"
            CornerRadius="16" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.22"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Border Grid.Row="0" Background="{DynamicResource GlassLightBrush}"
                    Padding="20,14" CornerRadius="16,16,0,0"
                    BorderThickness="0,0,0,1" BorderBrush="{DynamicResource BorderBrush}"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <controls:AppIcon Glyph="{x:Static controls:Icons.Chart}" FontSize="14"
                                          Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="我的年度报告" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                        <Button Content="‹" Style="{StaticResource SecondaryButton}" Padding="7,2" Margin="14,0,4,0"
                                Click="PrevYear_Click" ToolTip="上一年"/>
                        <TextBlock x:Name="YearText" Text="2026" FontSize="14" FontWeight="Bold"
                                   Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                        <Button Content="›" Style="{StaticResource SecondaryButton}" Padding="7,2" Margin="4,0,0,0"
                                Click="NextYear_Click" ToolTip="下一年"/>
                    </StackPanel>
                    <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                            Style="{StaticResource CloseButtonStyle}" Click="Close_Click" ToolTip="关闭"/>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" Padding="18,16" VerticalScrollBarVisibility="Auto">
                <!-- 报告卡（PNG 导出区域） -->
                <Border x:Name="ReportCard"
                        Background="{DynamicResource CardBrush}"
                        CornerRadius="16" Padding="22,20">
                    <StackPanel>
                        <TextBlock x:Name="CardTitle" Text="2026 · 年度报告"
                                   FontSize="19" FontWeight="Bold"
                                   Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center"/>

                        <!-- 主数字 -->
                        <TextBlock Text="这一年你完成了" FontSize="11.5"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center" Margin="0,16,0,0"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock x:Name="HeroCount" Text="0" FontSize="52" FontWeight="Bold"
                                       Foreground="{DynamicResource AccentBrush}"/>
                            <TextBlock Text="次" FontSize="17" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       VerticalAlignment="Bottom" Margin="6,0,0,10"/>
                        </StackPanel>

                        <!-- 四格数据 -->
                        <UniformGrid Columns="2" Margin="0,14,0,0">
                            <StackPanel Margin="0,0,0,10">
                                <Border Background="{DynamicResource SurfaceHoverBrush}" CornerRadius="10" Padding="12,9" Margin="0,0,6,0">
                                    <StackPanel>
                                        <TextBlock x:Name="BestComboText" Text="0 天" FontSize="16" FontWeight="Bold"
                                                   Foreground="{DynamicResource ComboBrush}"/>
                                        <TextBlock Text="最长连击" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <StackPanel Margin="0,0,0,10">
                                <Border Background="{DynamicResource SurfaceHoverBrush}" CornerRadius="10" Padding="12,9" Margin="6,0,0,0">
                                    <StackPanel>
                                        <TextBlock x:Name="FocusMinutesText" Text="0 分钟" FontSize="16" FontWeight="Bold"
                                                   Foreground="{DynamicResource SuccessBrush}"/>
                                        <TextBlock Text="累计专注" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <StackPanel>
                                <Border Background="{DynamicResource SurfaceHoverBrush}" CornerRadius="10" Padding="12,9" Margin="0,0,6,0">
                                    <StackPanel>
                                        <TextBlock x:Name="ActiveDaysText" Text="0 天" FontSize="16" FontWeight="Bold"
                                                   Foreground="{DynamicResource AccentBrush}"/>
                                        <TextBlock Text="活跃天数" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <StackPanel>
                                <Border Background="{DynamicResource SurfaceHoverBrush}" CornerRadius="10" Padding="12,9" Margin="6,0,0,0">
                                    <StackPanel>
                                        <TextBlock x:Name="BusiestWeekdayText" Text="—" FontSize="16" FontWeight="Bold"
                                                   Foreground="{DynamicResource WarningBrush}"/>
                                        <TextBlock Text="最勤奋的一天是" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </UniformGrid>

                        <!-- 月度趋势 -->
                        <TextBlock Text="月度完成趋势" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}" Margin="0,10,0,4"/>
                        <controls:LineChart x:Name="MonthChart" Height="110"/>

                        <TextBlock x:Name="FooterBrand" Text="每日任务 · TodoSidebar"
                                   FontSize="9.5" Foreground="{DynamicResource TextTertiaryBrush}"
                                   HorizontalAlignment="Center" Margin="0,14,0,0"/>
                    </StackPanel>
                </Border>
            </ScrollViewer>

            <!-- 底栏 -->
            <Border Grid.Row="2" Background="{DynamicResource GlassLightBrush}"
                    Padding="20,12" CornerRadius="0,0,16,16"
                    BorderThickness="0,1,0,0" BorderBrush="{DynamicResource BorderBrush}">
                <Grid>
                    <Button Content="保存为图片" Style="{StaticResource PrimaryButton}"
                            Padding="18,7" HorizontalAlignment="Left" Click="SaveImage_Click"/>
                    <Button Content="关闭" Style="{StaticResource SecondaryButton}"
                            Padding="24,7" HorizontalAlignment="Right" Click="Close_Click"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
